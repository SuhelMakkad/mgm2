---
import { Font } from 'astro:assets';

import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, contact } from '../data/site';

export interface Crumb {
  label: string;
  href: string;
}

interface Props {
  title: string;
  description?: string;

  /** Use `title` as the complete <title>, without the company suffix. */
  fullTitle?: boolean;

  ogType?: 'website' | 'article' | 'profile';
  noindex?: boolean;

  /** Trail from the home page to this page, used for BreadcrumbList structured data. */
  breadcrumbs?: Crumb[];

  /** Extra JSON-LD nodes for this page. */
  schema?: Record<string, unknown>[];
}

const { title, description = site.description, fullTitle = false, ogType = 'website', noindex = false, breadcrumbs = [], schema = [] } = Astro.props;

const origin = Astro.site ?? new URL(Astro.url.origin);
const absolute = (path: string) => new URL(path, origin).href;

/** Search results cut descriptions at roughly 160 characters, so end on a whole word before that. */
const clip = (text: string, limit = 158) => {
  if (text.length <= limit) return text;

  const cut = text.slice(0, limit);

  return `${cut.slice(0, cut.lastIndexOf(' ')).replace(/[,;:.]$/, '')}…`;
};

const pageTitle = fullTitle ? title : `${title} | ${site.shortName} Construction`;
const metaDescription = clip(description);
const canonical = absolute(Astro.url.pathname);
const ogImage = absolute('/og.jpg');

const organizationId = absolute('/#organization');
const hasRealEmail = !contact.email.endsWith('example.com');

const organization = {
  '@type': 'GeneralContractor',
  '@id': organizationId,
  name: site.name,
  alternateName: site.shortName,
  url: absolute('/'),
  logo: absolute('/icon-512.png'),
  image: ogImage,
  description: site.description,
  slogan: site.tagline,
  foundingDate: String(site.founded),
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.locality,
    addressCountry: site.countryCode,
  },
  areaServed: { '@type': 'Country', name: site.country },
  ...(hasRealEmail && { email: contact.email }),
  ...(contact.phone && { telephone: contact.phone }),
};

const website = {
  '@type': 'WebSite',
  '@id': absolute('/#website'),
  url: absolute('/'),
  name: site.name,
  inLanguage: 'en',
  publisher: { '@id': organizationId },
};

const breadcrumbList = breadcrumbs.length > 0 && {
  '@type': 'BreadcrumbList',
  itemListElement: [{ label: 'Home', href: '/' }, ...breadcrumbs].map((crumb, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: crumb.label,
    item: absolute(crumb.href),
  })),
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [organization, website, breadcrumbList, ...schema].filter(Boolean),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <Font cssVariable="--font-archivo" preload />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#111316" />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}. ${site.tagline}`} />
    <meta property="og:locale" content="en_AE" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
