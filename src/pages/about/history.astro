---
import Base from '../../layouts/base.astro';
import Arrow from '../../components/arrow.astro';
import CtaBand from '../../components/cta-band.astro';
import Media from '../../components/media.astro';
import PageHero from '../../components/page-hero.astro';

import { site } from '../../data/site';
import { image } from '../../data/images';
import { milestones } from '../../data/history';

const crumbs = [
  { label: 'About us', href: '/about/' },
  { label: 'History', href: '/about/history/' },
];
---

<Base
  title="Our History"
  description="From a coating contractor founded in Dubai in 1979 to a full-fledged construction company: the 47-year history of Al Madar MGM Construction LLC."
  breadcrumbs={crumbs}
>
  <PageHero
    label="Our history"
    title="A journey that began in 1979."
    lede="Our history is not simply measured in years, but in the trust we have earned, the relationships we have built, and the lasting contributions we continue to make."
    backdrop="history-skyline"
    crumbs={crumbs}
  />

  <section class="section">
    <div class="container">
      <ol class="timeline" role="list">
        {
          milestones.map((milestone, index) => (
            <li class="milestone" data-side={index % 2 === 0 ? 'left' : 'right'}>
              <span class="milestone__node" aria-hidden="true" />

              <div class="milestone__media" data-reveal="wipe">
                <Media src={image(milestone.image)} alt={milestone.imageAlt} ratio="4 / 3" sizes="(min-width: 60rem) 42vw, 100vw" />

                <p class="stamp">
                  {milestone.year && <strong>{milestone.year}</strong>}
                  <span>{milestone.stamp}</span>
                </p>
              </div>

              <div class="milestone__body stack" data-reveal style="--i:1">
                <h2 class="h2">{milestone.title}</h2>
                {milestone.body.map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section closing theme-dark">
    <div class="container closing__inner">
      <p class="closing__creed h1" data-reveal>
        <span>47 Years of Building Trust.</span>
        <span>A Future of Building Excellence.</span>
      </p>

      <p class="lede" data-reveal style="--i:1">
        Our journey is a testament to evolution, perseverance, and the courage to move forward. And our story continues.
      </p>

      <a class="btn" href="/about/team/" data-reveal style="--i:2">
        Meet the team behind {site.shortName}
        <Arrow />
      </a>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .timeline {
    position: relative;
    display: grid;
    gap: clamp(3.5rem, 8vw, 7.5rem);
    margin: 0;
    padding-left: 2rem;
  }

  /* The spine: a faint rule, with an accent rule that grows as the page scrolls. */

  .timeline::before,
  .timeline::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 2px;
  }

  .timeline::before {
    background: var(--line);
  }

  .timeline::after {
    background: var(--accent);
    transform-origin: top;
  }

  @supports (animation-timeline: view()) {
    .timeline::after {
      animation: spine linear both;
      animation-timeline: view();
      animation-range: entry 35% exit 65%;
    }
  }

  @keyframes spine {
    from {
      transform: scaleY(0);
    }
  }

  .milestone {
    position: relative;
    display: grid;
    gap: 1.75rem;
    align-items: center;
  }

  .milestone__node {
    position: absolute;
    z-index: 1;
    top: 0;
    left: calc(-2rem - 0.4375rem + 1px);
    width: 0.875rem;
    height: 0.875rem;

    background: var(--accent);
    border: 3px solid var(--bg);
    border-radius: 50%;
    box-sizing: content-box;
    margin: -3px;
  }

  .milestone__media {
    position: relative;
  }

  .milestone__media :global(.media) {
    border-radius: var(--radius-lg);
  }

  /* The date stamp sits on the corner of the picture. */

  .stamp {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    display: grid;
    gap: 0.15rem;
    padding: 0.8rem 1.1rem;
    border-radius: 10px;

    background: var(--accent);
    color: var(--on-accent);
  }

  .stamp strong {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    font-stretch: 125%;
    line-height: 0.9;
    letter-spacing: -0.045em;
    font-variant-numeric: lining-nums;
  }

  .stamp span {
    font-size: 0.6875rem;
    font-weight: 700;
    font-stretch: 112%;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .milestone__body {
    max-width: 34em;
  }

  .milestone__body p {
    color: var(--fg-muted);
  }

  .milestone__body p:first-of-type {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--fg);
  }

  /* From tablet up, the spine moves to the centre and milestones alternate sides. */

  @media (min-width: 60rem) {
    .timeline {
      padding-left: 0;
    }

    .timeline::before,
    .timeline::after {
      left: calc(50% - 1px);
    }

    .milestone {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(4rem, 9vw, 9rem);
    }

    .milestone__node {
      top: 50%;
      left: calc(50% - 0.4375rem);
    }

    .milestone[data-side='right'] .milestone__media {
      order: 2;
    }
  }

  /* Closing */

  .closing__inner {
    display: grid;
    justify-items: start;
    gap: 2rem;
  }

  .closing__creed {
    display: grid;
  }

  .closing__creed span:last-child {
    color: var(--accent);
  }
</style>
