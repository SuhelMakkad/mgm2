---
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import CtaBand from '../../components/CtaBand.astro';
import PageHero from '../../components/PageHero.astro';
import Plate from '../../components/Plate.astro';

import { site } from '../../data/site';
import { drawings } from '../../data/sectors';
import { milestones } from '../../data/history';

const crumbs = [
  { label: 'About us', href: '/about/' },
  { label: 'History', href: '/about/history/' },
];
---

<Base
  title="Our History"
  description="From a coating contractor founded in Dubai in 1979 to a full-fledged construction company: the 47-year history of Al Madar MGM Construction LLC."
  breadcrumbs={crumbs}
>
  <PageHero
    label="Our history"
    title="A journey that began in 1979."
    lede="Our history is not simply measured in years, but in the trust we have earned, the relationships we have built, and the lasting contributions we continue to make."
    crumbs={crumbs}
  />

  <section class="section">
    <div class="container">
      <ol class="timeline" role="list">
        {
          milestones.map((milestone, index) => (
            <li class="milestone">
              <div class="milestone__stamp" data-reveal>
                <span class="milestone__node" aria-hidden="true" />

                <p class="stamp" data-dated={milestone.year ? '' : undefined}>
                  {milestone.year && <span class="stamp__year">{milestone.year}</span>}
                  <span class="stamp__label">{milestone.stamp}</span>
                </p>
              </div>

              <div class="milestone__body stack" data-reveal style="--i:1">
                <h2 class="h2">{milestone.title}</h2>
                {milestone.body.map((paragraph) => <p>{paragraph}</p>)}
              </div>

              <div class="milestone__plate" data-reveal style="--i:2">
                <Plate
                  drawing={drawings[milestone.drawing]}
                  image={milestone.image}
                  alt={milestone.imageAlt ?? milestone.title}
                  tone={index % 2 === 0 ? 'dark' : 'light'}
                  ratio="5 / 4"
                  sizes="(min-width: 64rem) 30vw, 100vw"
                />
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section closing theme-dark">
    <div class="container closing__inner">
      <p class="closing__creed" data-reveal>
        <span>47 Years of Building Trust.</span>
        <span>A Future of Building Excellence.</span>
      </p>

      <p class="lede" data-reveal style="--i:1">
        Our journey is a testament to evolution, perseverance, and the courage to move forward. And our story continues.
      </p>

      <a class="arrow-link" href="/about/team/" data-reveal style="--i:2">
        Meet the team behind {site.shortName}
        <Arrow />
      </a>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .timeline {
    position: relative;
    display: grid;
    gap: clamp(3.5rem, 7vw, 6.5rem);
    margin: 0;
    padding-left: 2rem;
  }

  /* The spine: a faint rule, with a brass rule that grows as the page scrolls. */

  .timeline::before,
  .timeline::after {
    content: '';
    position: absolute;
    top: 0.6rem;
    bottom: 0;
    left: 0;
    width: 1px;
  }

  .timeline::before {
    background: var(--line-strong);
  }

  .timeline::after {
    background: var(--accent-line);
    transform-origin: top;
  }

  @supports (animation-timeline: view()) {
    .timeline::after {
      animation: spine linear both;
      animation-timeline: view();
      animation-range: entry 30% exit 70%;
    }
  }

  @keyframes spine {
    from {
      transform: scaleY(0);
    }
  }

  .milestone {
    position: relative;
    display: grid;
    gap: 1.5rem;
    align-items: start;
  }

  .milestone__stamp {
    position: relative;
  }

  .milestone__node {
    position: absolute;
    z-index: 1;
    top: 0.5rem;
    left: calc(-2rem - 0.3125rem);
    width: 0.6875rem;
    height: 0.6875rem;

    background: var(--bg);
    border: 1px solid var(--accent-line);
    border-radius: 50%;
  }

  .milestone:first-child .milestone__node,
  .milestone:last-child .milestone__node {
    background: var(--accent-line);
  }

  /* The date stamp */

  .stamp {
    display: inline-grid;
    gap: 0.35rem;
    justify-items: start;
  }

  .stamp__year {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.02em;
    font-variant-numeric: lining-nums;
  }

  .stamp__label {
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--accent-line);
    border-radius: var(--radius);

    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .stamp[data-dated] .stamp__label {
    margin-top: 0.4rem;
  }

  .milestone__body {
    max-width: 36em;
  }

  .milestone__body p {
    color: var(--fg-muted);
  }

  .milestone__body p:first-of-type {
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--fg);
  }

  .milestone__plate {
    width: min(100%, 26rem);
  }

  @media (min-width: 64rem) {
    .timeline {
      padding-left: 3rem;
    }

    .milestone {
      grid-template-columns: 11rem minmax(0, 1.25fr) minmax(0, 0.85fr);
      gap: clamp(2rem, 4vw, 4.5rem);
    }

    .milestone__node {
      left: calc(-3rem - 0.3125rem);
    }

    .milestone__plate {
      width: 100%;
    }
  }

  /* Closing */

  .closing__inner {
    display: grid;
    justify-items: start;
    gap: 2rem;
  }

  .closing__creed {
    display: grid;

    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .closing__creed span:last-child {
    color: var(--accent);
  }
</style>
