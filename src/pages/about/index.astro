---
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import CtaBand from '../../components/CtaBand.astro';
import PageHero from '../../components/PageHero.astro';
import Portrait from '../../components/Portrait.astro';
import SectionHead from '../../components/SectionHead.astro';

import { site, groupCompanies } from '../../data/site';
import { evolution } from '../../data/history';
import { getTeam } from '../../data/projects';

const team = await getTeam();
const director = team[0];

const crumbs = [{ label: 'About us', href: '/about/' }];

const anchors = [
  { label: 'Mission & vision', href: '#mission' },
  { label: 'Message from the MD', href: '#message' },
  { label: 'History', href: '#history' },
  { label: 'The team', href: '#team' },
  { label: 'Group companies', href: '#group' },
];

const message = [
  'For over 47 years, our journey in the construction industry has been shaped by a steadfast commitment to quality, integrity, reliability, and excellence. What began as a vision has grown into a legacy built on trust, dedication, and the successful delivery of projects that contribute to the growth and development of Dubai and the wider UAE.',
  'Throughout these years, we have remained guided by a simple yet powerful belief: that every project we undertake is more than just a structure; it is a responsibility, a commitment, and an opportunity to create something lasting. Our reputation has been built not only on the projects we deliver, but also on the relationships we nurture with our clients, consultants, partners, and suppliers.',
  'Our greatest strength lies in our people. Their expertise, professionalism, dedication, and shared passion for excellence have been instrumental in shaping our success and sustaining our position in an ever-evolving industry.',
  "As we look ahead, we remain committed to building on our proud heritage while embracing innovation, modern construction practices, sustainability, and new opportunities. With the same determination and values that have guided us for nearly five decades, we look forward to contributing to the UAE's ambitious vision and shaping a future we can all be proud of.",
  'On behalf of our entire team, I extend my sincere appreciation to our valued clients, business partners, and everyone who has been part of our journey. Your continued trust and confidence inspire us to aim higher and deliver better.',
  'Thank you for being part of our journey.',
];
---

<Base
  title="About Us"
  description="Building in Dubai since 1979. Our mission and vision, a message from the Managing Director, our history and the team behind Al Madar MGM Construction."
  breadcrumbs={crumbs}
  schema={[{ '@type': 'AboutPage', name: `About ${site.name}`, url: new URL('/about/', Astro.site).href }]}
>
  <PageHero
    label="About us"
    title="Built on trust since 1979."
    lede="For over 47 years we have been part of the growth and development of Dubai and the wider UAE, guided by quality, integrity, reliability and excellence."
    crumbs={crumbs}
  >
    <ul class="anchors" role="list">
      {
        anchors.map((anchor) => (
          <li>
            <a href={anchor.href}>{anchor.label}</a>
          </li>
        ))
      }
    </ul>
  </PageHero>

  <section class="section" id="mission">
    <div class="container">
      <SectionHead label="Mission & vision" title="What we set out to do, and where we are going." />

      <div class="pillars">
        <article class="pillar" data-reveal>
          <h3 class="pillar__name">Mission</h3>

          <p>
            To transform visions into enduring landmarks through superior construction expertise, uncompromising quality, and a steadfast commitment to excellence. We strive to deliver projects that stand the test of time while building lasting trust with our clients, partners, and communities.
          </p>
        </article>

        <article class="pillar" data-reveal style="--i:1">
          <h3 class="pillar__name">Vision</h3>

          <p>
            To build on our 47+ year legacy and become a benchmark for excellence in the construction industry, shaping the future of the UAE through innovation, sustainability, and outstanding construction achievements.
          </p>
        </article>
      </div>

      <p class="creed" data-reveal>
        <span>47 Years of Building Trust.</span>
        <span>A Future of Building Excellence.</span>
      </p>
    </div>
  </section>

  <section class="section theme-tint" id="message">
    <div class="container letter">
      <aside class="letter__aside" data-reveal>
        <Portrait name={director.data.name} photo={director.data.photo} eager />

        <p class="letter__sign">
          <strong>{director.data.name}</strong>
          <span class="muted">{director.data.role}</span>
        </p>
      </aside>

      <div class="letter__body">
        <SectionHead label="Message from the MD" title="It is my great pleasure to welcome you to Al Madar MGM Construction LLC." />

        <div class="prose letter__prose" data-reveal>
          {message.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <p class="letter__close" data-reveal>
          <strong>John Kurien</strong>
          <span class="muted">Managing Director</span>
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="history">
    <div class="container history">
      <SectionHead
        label="History"
        title="Established in 1979, and growing with Dubai ever since."
        lede="What began as a humble coating contracting company metamorphosed into a civil maintenance company and further grew into a full-fledged construction company."
      >
        <a class="arrow-link" href="/about/history/">
          Read our history
          <Arrow />
        </a>
      </SectionHead>

      <ol class="steps" role="list">
        {
          evolution.map((step, index) => (
            <li data-reveal style={`--i:${index}`}>
              <span class="steps__index">{index === 0 ? site.founded : index === evolution.length - 1 ? 'Today' : 'Then'}</span>
              <strong class="h3">{step.label}</strong>
              <span class="muted">{step.note}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section theme-dark" id="team">
    <div class="container">
      <div class="team-head">
        <SectionHead
          label="The team"
          title="Our greatest strength lies in our people."
          lede="Meet the leadership that has shaped the company and continues to drive it forward."
        />

        <a class="arrow-link" href="/about/team/" data-reveal>
          Meet the team
          <Arrow />
        </a>
      </div>

      <ul class="team-row" role="list">
        {
          team.map((member, index) => (
            <li data-reveal style={`--i:${index}`}>
              <a class="team-row__link" href={`/about/team/${member.id}/`}>
                <Portrait name={member.data.name} photo={member.data.photo} sizes="(min-width: 64rem) 18vw, 45vw" />

                <span class="team-row__name">{member.data.name}</span>
                <span class="muted">{member.data.role}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" id="group">
    <div class="container group">
      <SectionHead label="Our group companies" title="Part of a wider group." lede="Al Madar MGM Construction works alongside its sister companies." />

      <ul class="group__list" role="list">
        {
          groupCompanies.map((company, index) => (
            <li data-reveal style={`--i:${index}`}>
              {
                company.url ? (
                  <a class="group__card" href={company.url} rel="noopener">
                    <span class="h3">{company.name}</span>
                    <Arrow />
                  </a>
                ) : (
                  <span class="group__card">
                    <span class="h3">{company.name}</span>
                    <span class="group__tag">Group company</span>
                  </span>
                )
              }
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .anchors {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.75rem 0 0;
  }

  .anchors a {
    display: inline-block;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);

    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      border-color 0.25s,
      color 0.25s;
  }

  .anchors a:hover {
    border-color: var(--accent-line);
    color: var(--accent);
  }

  /* Mission and vision */

  .pillars {
    display: grid;
    gap: 0;
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
    border-top: 1px solid var(--line-strong);
  }

  .pillar {
    display: grid;
    gap: 1.25rem;
    align-content: start;
    padding-block: 2.25rem;
    border-bottom: 1px solid var(--line);

    font-size: var(--step-1);
    line-height: 1.6;
  }

  .pillar__name {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .creed {
    display: grid;
    margin-top: clamp(3rem, 6vw, 5.5rem);

    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .creed span:last-child {
    color: var(--accent);
  }

  @media (min-width: 52rem) {
    .pillars {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pillar {
      padding: 2.75rem clamp(2rem, 4vw, 4rem) 2.75rem 0;
    }

    .pillar + .pillar {
      padding-left: clamp(2rem, 4vw, 4rem);
      border-left: 1px solid var(--line);
    }
  }

  /* MD's letter */

  .letter {
    display: grid;
    gap: 3rem;
    align-items: start;
  }

  .letter__aside {
    display: grid;
    gap: 1.25rem;
    width: min(100%, 22rem);
  }

  .letter__sign,
  .letter__close {
    display: grid;
    gap: 0.1rem;
  }

  .letter__sign strong,
  .letter__close strong {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
  }

  .letter__body {
    display: grid;
    gap: 2.5rem;
  }

  .letter__prose p:first-child {
    font-size: inherit;
    line-height: inherit;
  }

  .letter__close {
    padding-top: 1.75rem;
    border-top: 1px solid var(--line-strong);
    max-width: 40em;
  }

  @media (min-width: 60rem) {
    .letter {
      grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
      gap: clamp(3rem, 7vw, 7rem);
    }

    .letter__aside {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
      width: 100%;
    }

    .letter__close {
      display: none;
    }
  }

  @media (max-width: 59.99rem) {
    .letter__sign {
      display: none;
    }
  }

  /* History teaser */

  .history {
    display: grid;
    gap: 3rem;
    align-items: start;
  }

  .steps {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--line-strong);
  }

  .steps li {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: 0.2rem 1.5rem;
    padding-block: 1.6rem;
    border-bottom: 1px solid var(--line);
  }

  .steps__index {
    grid-row: span 2;
    padding-top: 0.45rem;

    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .steps .muted {
    grid-column: 2;
    font-size: 0.9375rem;
  }

  @media (min-width: 60rem) {
    .history {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(3rem, 7vw, 7rem);
    }
  }

  /* Team row */

  .team-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .team-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.25rem 1.25rem;
    margin: 0;
  }

  .team-row__link {
    display: grid;
    gap: 0.2rem;
    text-decoration: none;
  }

  .team-row__name {
    margin-top: 0.9rem;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.25;
  }

  .team-row .muted {
    font-size: 0.8438rem;
    line-height: 1.4;
  }

  @media (min-width: 40rem) {
    .team-row {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .team-row {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  /* Group companies */

  .group {
    display: grid;
    gap: 3rem;
    align-items: start;
  }

  .group__list {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--line-strong);
  }

  .group__card {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  .group__tag {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .group__card :global(svg) {
    width: 1.3rem;
    height: 1.3rem;
    color: var(--accent);
  }

  @media (min-width: 60rem) {
    .group {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(3rem, 7vw, 7rem);
    }
  }
</style>
