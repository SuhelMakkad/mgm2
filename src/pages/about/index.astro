---
import Base from '../../layouts/base.astro';
import Arrow from '../../components/arrow.astro';
import CtaBand from '../../components/cta-band.astro';
import Icon from '../../components/icon.astro';
import Media from '../../components/media.astro';
import PageHero from '../../components/page-hero.astro';
import Portrait from '../../components/portrait.astro';
import SectionHead from '../../components/section-head.astro';

import { site, groupCompanies } from '../../data/site';
import { image } from '../../data/images';
import { evolution } from '../../data/history';
import { getTeam } from '../../data/projects';

const team = await getTeam();
const director = team[0];

const crumbs = [{ label: 'About us', href: '/about/' }];

const anchors = [
  { label: 'Mission & vision', href: '#mission' },
  { label: 'Message from the MD', href: '#message' },
  { label: 'History', href: '#history' },
  { label: 'The team', href: '#team' },
  { label: 'Group companies', href: '#group' },
];

const pillars = [
  {
    icon: 'target',
    name: 'Mission',
    text: 'To transform visions into enduring landmarks through superior construction expertise, uncompromising quality, and a steadfast commitment to excellence. We strive to deliver projects that stand the test of time while building lasting trust with our clients, partners, and communities.',
  },
  {
    icon: 'binoculars',
    name: 'Vision',
    text: 'To build on our 47+ year legacy and become a benchmark for excellence in the construction industry, shaping the future of the UAE through innovation, sustainability, and outstanding construction achievements.',
  },
];

const message = [
  'For over 47 years, our journey in the construction industry has been shaped by a steadfast commitment to quality, integrity, reliability, and excellence. What began as a vision has grown into a legacy built on trust, dedication, and the successful delivery of projects that contribute to the growth and development of Dubai and the wider UAE.',
  'Throughout these years, we have remained guided by a simple yet powerful belief: that every project we undertake is more than just a structure; it is a responsibility, a commitment, and an opportunity to create something lasting. Our reputation has been built not only on the projects we deliver, but also on the relationships we nurture with our clients, consultants, partners, and suppliers.',
  'Our greatest strength lies in our people. Their expertise, professionalism, dedication, and shared passion for excellence have been instrumental in shaping our success and sustaining our position in an ever-evolving industry.',
  "As we look ahead, we remain committed to building on our proud heritage while embracing innovation, modern construction practices, sustainability, and new opportunities. With the same determination and values that have guided us for nearly five decades, we look forward to contributing to the UAE's ambitious vision and shaping a future we can all be proud of.",
  'On behalf of our entire team, I extend my sincere appreciation to our valued clients, business partners, and everyone who has been part of our journey. Your continued trust and confidence inspire us to aim higher and deliver better.',
  'Thank you for being part of our journey.',
];
---

<Base
  title="About Us"
  description="Building in Dubai since 1979. Our mission and vision, a message from the Managing Director, our history and the team behind Al Madar MGM Construction."
  breadcrumbs={crumbs}
  schema={[{ '@type': 'AboutPage', name: `About ${site.name}`, url: new URL('/about/', Astro.site).href }]}
>
  <PageHero label="About us" title="Built on trust since 1979." backdrop="about-site" position="center 30%" crumbs={crumbs}>
    <ul class="anchors" role="list">
      {
        anchors.map((anchor) => (
          <li>
            <a href={anchor.href}>{anchor.label}</a>
          </li>
        ))
      }
    </ul>
  </PageHero>

  <section class="section" id="mission">
    <div class="container">
      <SectionHead label="Mission & vision" title="What we set out to do, and where we are going." />

      <div class="pillars">
        {
          pillars.map((pillar, index) => (
            <article class="pillar" data-reveal style={`--i:${index}`}>
              <span class="pillar__icon">
                <Icon name={pillar.icon} />
              </span>

              <h3 class="h3">{pillar.name}</h3>
              <p>{pillar.text}</p>
            </article>
          ))
        }
      </div>

      <p class="creed h1" data-reveal>
        <span>47 Years of Building Trust.</span>
        <span>A Future of Building Excellence.</span>
      </p>
    </div>
  </section>

  <section class="section theme-tint" id="message">
    <div class="container letter">
      <aside class="letter__aside" data-reveal>
        <Portrait name={director.data.name} photo={director.data.photo} eager />

        <p class="letter__sign">
          <strong>{director.data.name}</strong>
          <span class="muted">{director.data.role}</span>
        </p>
      </aside>

      <div class="letter__body">
        <SectionHead label="Message from the MD" title="It is my great pleasure to welcome you to Al Madar MGM Construction LLC." />

        <div class="prose" data-reveal>
          {message.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <p class="letter__close" data-reveal>
          <strong>John Kurien</strong>
          <span class="muted">Managing Director</span>
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="history">
    <div class="container history">
      <div class="history__media" data-reveal="wipe">
        <Media src={image('history-skyline')} alt="A Gulf city skyline at dusk" ratio="4 / 3" sizes="(min-width: 60rem) 45vw, 100vw" />
      </div>

      <div class="history__body">
        <SectionHead label="History" title="Established in 1979, and growing with Dubai ever since." />

        <ol class="steps" role="list">
          {
            evolution.map((step, index) => (
              <li data-reveal style={`--i:${index}`}>
                <span class="steps__icon">
                  <Icon name={step.icon} />
                </span>

                <strong class="h3">{step.label}</strong>
                <span class="muted">{step.note}</span>
              </li>
            ))
          }
        </ol>

        <a class="btn" href="/about/history/" data-reveal>
          Read our history
          <Arrow />
        </a>
      </div>
    </div>
  </section>

  <section class="section theme-dark" id="team">
    <div class="container">
      <div class="team-head">
        <SectionHead label="The team" title="Our greatest strength lies in our people." />

        <a class="arrow-link" href="/about/team/" data-reveal>
          Meet the team
          <Arrow />
        </a>
      </div>

      <ul class="team-row" role="list">
        {
          team.map((member, index) => (
            <li data-reveal style={`--i:${index}`}>
              <a class="team-row__link" href={`/about/team/${member.id}/`}>
                <Portrait name={member.data.name} photo={member.data.photo} sizes="(min-width: 64rem) 18vw, 45vw" />

                <span class="team-row__name">{member.data.name}</span>
                <span class="muted">{member.data.role}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" id="group">
    <div class="container group">
      <SectionHead label="Our group companies" title="Part of a wider group." />

      <ul class="group__list" role="list">
        {
          groupCompanies.map((company, index) => (
            <li data-reveal style={`--i:${index}`}>
              {
                company.url ? (
                  <a class="group__card" href={company.url} rel="noopener">
                    <Icon name="buildings" />
                    <span class="h3">{company.name}</span>
                    <Icon name="arrow-up-right" />
                  </a>
                ) : (
                  <span class="group__card">
                    <Icon name="buildings" />
                    <span class="h3">{company.name}</span>
                  </span>
                )
              }
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .anchors {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.5rem 0 0;
  }

  .anchors a {
    display: inline-block;
    padding: 0.55rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;

    background: color-mix(in srgb, var(--ink-950) 40%, transparent);
    backdrop-filter: blur(8px);

    font-size: 0.875rem;
    font-weight: 560;
    text-decoration: none;
    transition:
      background-color 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out),
      color 0.3s var(--ease-out);
  }

  .anchors a:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }

  /* Mission and vision */

  .pillars {
    display: grid;
    gap: 1rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .pillar {
    display: grid;
    gap: 1rem;
    align-content: start;
    padding: clamp(1.75rem, 3.5vw, 3rem);
    border-radius: var(--radius-lg);

    background: var(--surface);
    font-size: var(--step-1);
    line-height: 1.55;
  }

  .pillar:last-child {
    background: var(--ink-900);
    color: var(--on-dark);
  }

  .pillar__icon {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    margin-bottom: 0.75rem;
    border-radius: 50%;

    background: var(--accent);
    color: var(--on-accent);
  }

  .pillar__icon :global(.icon) {
    width: 1.75rem;
    height: 1.75rem;
  }

  .creed {
    display: grid;
    margin-top: clamp(3.5rem, 7vw, 6.5rem);
  }

  .creed span:last-child {
    color: var(--accent-text);
  }

  @media (min-width: 52rem) {
    .pillars {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* MD's letter */

  .letter {
    display: grid;
    gap: 3rem;
    align-items: start;
  }

  .letter__aside {
    display: grid;
    gap: 1.25rem;
    width: min(100%, 22rem);
  }

  .letter__sign,
  .letter__close {
    display: grid;
    gap: 0.1rem;
  }

  .letter__sign strong,
  .letter__close strong {
    font-size: 1.1875rem;
    font-weight: 720;
    font-stretch: 114%;
  }

  .letter__body {
    display: grid;
    gap: 2.5rem;
  }

  .letter__close {
    padding-top: 1.75rem;
    border-top: 1px solid var(--line-strong);
    max-width: 40em;
  }

  @media (min-width: 60rem) {
    .letter {
      grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
      gap: clamp(3rem, 7vw, 7rem);
    }

    .letter__aside {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
      width: 100%;
    }

    .letter__close {
      display: none;
    }
  }

  @media (max-width: 59.99rem) {
    .letter__sign {
      display: none;
    }
  }

  /* History teaser */

  .history {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .history__media :global(.media) {
    border-radius: var(--radius-lg);
  }

  .history__body {
    display: grid;
    justify-items: start;
    gap: 2.25rem;
  }

  .steps {
    display: grid;
    width: 100%;
    margin: 0;
    border-top: 1px solid var(--line-strong);
  }

  .steps li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 1.25rem;
    align-items: center;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .steps__icon {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;

    background: var(--paper-2);
    color: var(--accent-text);
  }

  .steps .muted {
    font-size: 0.9375rem;
  }

  @media (min-width: 60rem) {
    .history {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(3rem, 7vw, 7rem);
    }
  }

  /* Team row */

  .team-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .team-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.25rem 1rem;
    margin: 0;
  }

  .team-row__link {
    display: grid;
    gap: 0.2rem;
    text-decoration: none;
  }

  .team-row__name {
    margin-top: 0.9rem;
    font-size: 1.0625rem;
    font-weight: 720;
    font-stretch: 114%;
    line-height: 1.25;
  }

  .team-row .muted {
    font-size: 0.8438rem;
    line-height: 1.4;
  }

  @media (min-width: 40rem) {
    .team-row {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .team-row {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  /* Group companies */

  .group {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  .group__list {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }

  .group__card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.5rem 1.75rem;
    border-radius: var(--radius-lg);

    background: var(--surface);
    text-decoration: none;
  }

  .group__card :global(.icon:first-child) {
    width: 2rem;
    height: 2rem;
    color: var(--accent-text);
  }

  .group__card :global(.icon:last-child:not(:first-child)) {
    margin-left: auto;
  }

  @media (min-width: 60rem) {
    .group {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(3rem, 7vw, 7rem);
    }
  }
</style>
