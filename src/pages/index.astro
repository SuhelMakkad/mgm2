---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import Marquee from '../components/Marquee.astro';
import Media from '../components/Media.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHead from '../components/SectionHead.astro';

import { site } from '../data/site';
import { image } from '../data/images';
import { serviceGroups, serviceCount } from '../data/services';
import { sectors } from '../data/sectors';
import { evolution } from '../data/history';
import { certifications } from '../data/certifications';
import { getProjects } from '../data/projects';

const projects = await getProjects();
const [leadProject, ...sideProjects] = projects.filter((project) => project.data.featured).slice(0, 3);

// "47 Years of Building Trust." is the headline; the second sentence of the tagline closes the page intro.
const [headline, promise] = site.tagline.split('. ').map((sentence) => (sentence.endsWith('.') ? sentence : `${sentence}.`));
const [headlineTop, headlineRest] = headline.split(/(?<= of) /);
const headlineWords = headlineRest.split(' ');
const headlineLast = headlineWords.pop();

const stats = [
  { icon: 'flag-banner', value: String(site.founded), label: 'Established in Dubai' },
  { icon: 'handshake', value: `${site.years}+`, count: site.years, suffix: '+', label: 'Years of building trust' },
  { icon: 'toolbox', value: String(serviceCount), count: serviceCount, label: 'Services under one roof' },
  { icon: 'buildings', value: String(sectors.length), count: sectors.length, label: 'Sectors served' },
];

const allServices = serviceGroups.flatMap((group) => group.services.map((service) => service.name));
---

<Base title={`${site.name} | Construction Company in Dubai, UAE`} fullTitle>
  <section class="hero theme-dark">
    <div class="hero__backdrop" aria-hidden="true">
      <Media src={image('hero-home')} alt="" ratio="fill" sizes="100vw" position="72% center" eager />
    </div>

    <div class="container hero__inner">
      <p class="label rise">{site.locality}, UAE · Since {site.founded}</p>

      <h1 class="display hero__title">
        <span class="visually-hidden">{site.name}: </span>
        <span class="line-mask" style="--d:1"><span>{headlineTop} </span></span>
        <span class="line-mask" style="--d:2"><span>{headlineWords.join(' ')} <span class="hero__accent">{headlineLast}</span></span></span>
      </h1>

      <div class="hero__foot rise" style="--d:6">
        <div class="hero__actions">
          <a class="btn" href="/projects/">
            Explore our work
            <Arrow />
          </a>

          <a class="btn btn--ghost" href="/services/">What we do</a>
        </div>

        <a class="hero__scroll" href="#intro">
          <span>Scroll</span>
          <i aria-hidden="true"></i>
        </a>
      </div>
    </div>
  </section>

  <Marquee items={allServices} />

  <section class="section" id="intro">
    <div class="container intro">
      <div class="intro__media">
        <div data-reveal="wipe">
          <Media src={image('about-site')} alt="Two site engineers reviewing drawings in front of a building under construction" ratio="4 / 5" sizes="(min-width: 64rem) 42vw, 100vw" />
        </div>

        <p class="intro__badge" data-reveal style="--i:4">
          <strong>{site.years}</strong>
          <span>years in the UAE</span>
        </p>
      </div>

      <div class="intro__body">
        <SectionHead label="Who we are" title="From a coating contractor to a full-fledged construction company.">
          <p class="lede">
            Established in {site.founded}, we have grown alongside Dubai for {site.years} years. <span class="intro__promise">{promise}</span>
          </p>
        </SectionHead>

        <ol class="evolution" role="list">
          {
            evolution.map((step, index) => (
              <li data-reveal style={`--i:${index}`}>
                <span class="evolution__icon">
                  <Icon name={step.icon} />
                </span>

                <strong>{step.label}</strong>
                <span class="muted">{step.note}</span>
              </li>
            ))
          }
        </ol>

        <p class="intro__links" data-reveal>
          <a class="btn" href="/about/">
            About the company
            <Arrow />
          </a>

          <a class="arrow-link" href="/about/history/">
            Our history
            <Arrow />
          </a>
        </p>
      </div>
    </div>

    <div class="container">
      <dl class="stats">
        {
          stats.map((stat, index) => (
            <div class="stats__item" data-reveal style={`--i:${index}`}>
              <Icon name={stat.icon} />
              <dt>{stat.label}</dt>

              <dd data-count={stat.count} data-suffix={stat.suffix}>
                {stat.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section theme-dark">
    <div class="container">
      <div class="split-head">
        <SectionHead
          label="Services"
          title="One contractor, from foundations to gold leaf."
          lede={`${serviceCount} services across four disciplines.`}
        />

        <a class="arrow-link" href="/services/" data-reveal>
          All services
          <Arrow />
        </a>
      </div>

      <ul class="panels" role="list" data-reveal>
        {
          serviceGroups.map((group) => (
            <li class="panel">
              <a class="panel__link" href={`/services/#${group.id}`}>
                <Media src={image(group.image)} alt="" ratio="fill" sizes="(min-width: 60rem) 45vw, 100vw" />

                <span class="panel__top">
                  <span class="panel__letter">{group.letter}</span>
                  <Icon name={group.icon} />
                </span>

                <span class="panel__short" aria-hidden="true">
                  {group.short}
                </span>

                <span class="panel__body">
                  <strong class="h3">{group.title}</strong>
                  <small>{group.services.length} services</small>

                  <span class="panel__list">{group.services.map((service) => service.name).join(' · ')}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section sectors">
    <div class="container">
      <div class="split-head">
        <SectionHead label="Sectors" title={`Experience across ${sectors.length} sectors.`} />

        <div class="rail-controls" data-reveal>
          <button type="button" data-rail-prev aria-label="Previous sectors">
            <Icon name="arrow-left-bold" />
          </button>

          <button type="button" data-rail-next aria-label="Next sectors">
            <Icon name="arrow-right-bold" />
          </button>
        </div>
      </div>
    </div>

    <ul class="rail" role="list" data-rail>
      {
        sectors.map((sector, index) => (
          <li data-reveal style={`--i:${Math.min(index, 5)}`}>
            <a class="sector-card" href={`/sectors/#${sector.id}`}>
              <Media src={image(sector.image)} alt="" ratio="fill" sizes="(min-width: 64rem) 22vw, 70vw" />

              <span class="sector-card__icon">
                <Icon name={sector.icon} />
              </span>

              <span class="sector-card__name">{sector.name}</span>
            </a>
          </li>
        ))
      }

      <li class="rail__end">
        <a class="arrow-link" href="/sectors/">
          All sectors
          <Arrow />
        </a>
      </li>
    </ul>
  </section>

  <section class="section theme-tint">
    <div class="container">
      <div class="split-head">
        <SectionHead label="Projects" title="Work in progress, work delivered." />

        <a class="arrow-link" href="/projects/" data-reveal>
          All projects
          <Arrow />
        </a>
      </div>

      <ul class="featured" role="list">
        <li class="featured__lead" data-reveal>
          <ProjectCard project={leadProject} ratio="5 / 4" sizes="(min-width: 64rem) 55vw, 100vw" />
        </li>

        {
          sideProjects.map((project, index) => (
            <li data-reveal style={`--i:${index + 1}`}>
              <ProjectCard project={project} ratio="16 / 9" sizes="(min-width: 64rem) 38vw, 100vw" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section quote theme-dark">
    <div class="container quote__inner">
      <Icon name="quotes-fill" class="quote__mark" />

      <blockquote class="quote__text h2" data-reveal>
        <p>
          Every project we undertake is more than just a structure; it is a responsibility, a commitment, and an opportunity to create something lasting.
        </p>
      </blockquote>

      <div class="quote__foot" data-reveal style="--i:1">
        <p>
          <strong>John Kurien</strong>
          <span class="muted">Managing Director</span>
        </p>

        <a class="arrow-link" href="/about/#message">
          Read the full message
          <Arrow />
        </a>
      </div>
    </div>
  </section>

  <section class="certs">
    <div class="container certs__inner" data-reveal>
      <p class="label">Certifications</p>

      <ul class="certs__list" role="list">
        {
          certifications.map((certification) => (
            <li>
              <Icon name={certification.icon} />
              {certification.name}
            </li>
          ))
        }
      </ul>

      <a class="arrow-link" href="/certifications/">
        View certifications
        <Arrow />
      </a>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* ------------------------------------------------------------------------
     Hero: one photograph, one line, two actions.
     ------------------------------------------------------------------------ */

  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: max(34rem, 100svh);
    overflow: hidden;
    padding-block: calc(var(--header-h) + 3rem) clamp(2rem, 1.25rem + 3vw, 4rem);
    background: var(--ink-950);
  }

  .hero__backdrop {
    position: absolute;
    inset: 0;
  }

  .hero__backdrop :global(img) {
    animation: hero-settle 2.6s var(--ease-out) both;
  }

  .hero__backdrop::after {
    content: '';
    position: absolute;
    inset: 0;

    background:
      linear-gradient(to top, var(--ink-950) 0%, color-mix(in srgb, var(--ink-950) 55%, transparent) 38%, transparent 68%),
      linear-gradient(to right, color-mix(in srgb, var(--ink-950) 62%, transparent), transparent 62%),
      linear-gradient(to bottom, color-mix(in srgb, var(--ink-950) 55%, transparent), transparent 22%);
  }

  @keyframes hero-settle {
    from {
      transform: scale(1.12);
    }
  }

  /* The picture drifts a little slower than the page as it scrolls away. */

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero__backdrop {
        animation: hero-drift linear both;
        animation-timeline: scroll(root);
        animation-range: 0 100svh;
      }
    }
  }

  @keyframes hero-drift {
    to {
      transform: translateY(14%);
    }
  }

  .hero__inner {
    position: relative;
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  .hero__title {
    display: grid;
    font-size: clamp(2.4rem, 11.2vw, 7.75rem);
  }

  .hero__accent {
    color: var(--accent);
  }

  .hero__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-top: clamp(0.5rem, 2vw, 1.5rem);
    padding-top: clamp(1.25rem, 2.5vw, 2rem);
    border-top: 1px solid var(--line-strong);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero__scroll {
    display: none;
    align-items: center;
    gap: 0.9rem;

    font-size: 0.75rem;
    font-weight: 650;
    font-stretch: 112%;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .hero__scroll i {
    position: relative;
    width: 1px;
    height: 3.25rem;
    overflow: hidden;
    background: var(--line-strong);
  }

  .hero__scroll i::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent);
    animation: scroll-cue 2.2s var(--ease-in-out) infinite;
  }

  @keyframes scroll-cue {
    from {
      transform: translateY(-100%);
    }

    to {
      transform: translateY(100%);
    }
  }

  @media (min-width: 48rem) {
    .hero__scroll {
      display: inline-flex;
    }
  }

  /* ------------------------------------------------------------------------
     Shared: section head with a trailing link
     ------------------------------------------------------------------------ */

  .split-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-bottom: clamp(2.25rem, 4.5vw, 4rem);
  }

  /* ------------------------------------------------------------------------
     Intro
     ------------------------------------------------------------------------ */

  .intro {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .intro__media {
    position: relative;
  }

  .intro__media :global(.media) {
    border-radius: var(--radius-lg);
  }

  .intro__badge {
    position: absolute;
    right: -0.5rem;
    bottom: -1.5rem;
    display: grid;
    align-content: center;
    gap: 0.2rem;
    width: clamp(8.5rem, 16vw, 11.5rem);
    aspect-ratio: 1;
    padding: 1.1rem;
    border-radius: var(--radius-lg);

    background: var(--accent);
    color: var(--on-accent);
  }

  .intro__badge strong {
    font-size: clamp(3rem, 6vw, 4.75rem);
    font-weight: 800;
    font-stretch: 125%;
    line-height: 0.85;
    letter-spacing: -0.05em;
  }

  .intro__badge span {
    font-size: 0.8125rem;
    font-weight: 650;
    font-stretch: 110%;
    line-height: 1.25;
  }

  .intro__body {
    display: grid;
    gap: 2.5rem;
  }

  .intro__promise {
    color: var(--fg);
    font-weight: 600;
  }

  .intro__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
  }

  .evolution {
    display: grid;
    gap: 1.25rem;
    margin: 0;
  }

  .evolution li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 1rem;
    align-items: center;
  }

  .evolution__icon {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--paper-2);
    color: var(--accent-text);
  }

  .evolution strong {
    font-weight: 680;
    font-stretch: 110%;
    line-height: 1.3;
  }

  .evolution .muted {
    font-size: 0.875rem;
  }

  @media (min-width: 40rem) {
    .evolution {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .evolution li {
      grid-template-columns: 1fr;
      row-gap: 0.2rem;
      padding-top: 1.25rem;
      border-top: 2px solid var(--line);
    }

    .evolution li:last-child {
      border-top-color: var(--accent);
    }

    .evolution__icon {
      grid-row: auto;
      margin-bottom: 0.6rem;
    }
  }

  @media (min-width: 64rem) {
    .intro {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: clamp(3.5rem, 7vw, 7rem);
    }

    .intro__badge {
      right: -2rem;
    }
  }

  /* Stats */

  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1.5rem;
    margin: clamp(4.5rem, 8vw, 7.5rem) 0 0;
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--line-strong);
  }

  .stats__item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .stats__item :global(.icon) {
    order: -2;
    width: 1.75rem;
    height: 1.75rem;
    color: var(--accent-text);
  }

  .stats dd {
    order: -1;
    font-size: clamp(2.75rem, 1.6rem + 5vw, 5.75rem);
    font-weight: 800;
    font-stretch: 125%;
    line-height: 0.9;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums lining-nums;
  }

  .stats dt {
    font-size: 0.9375rem;
    color: var(--fg-muted);
  }

  @media (min-width: 52rem) {
    .stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* ------------------------------------------------------------------------
     Services: four panels that open on hover
     ------------------------------------------------------------------------ */

  .panels {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }

  .panel__link {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    height: 100%;
    min-height: 19rem;
    overflow: hidden;
    padding: 1.4rem;
    border-radius: var(--radius-lg);

    text-decoration: none;
    isolation: isolate;
  }

  .panel__link :global(.media) {
    z-index: -1;
  }

  .panel__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;

    background: linear-gradient(to top, var(--ink-950) 6%, color-mix(in srgb, var(--ink-950) 58%, transparent) 55%, color-mix(in srgb, var(--ink-950) 30%, transparent));
  }

  .panel__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .panel__letter {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;

    background: var(--accent);
    color: var(--on-accent);
    font-weight: 750;
    font-stretch: 115%;
  }

  .panel__top :global(.icon) {
    width: 2rem;
    height: 2rem;
  }

  .panel__body {
    display: grid;
    gap: 0.3rem;
  }

  .panel__body small {
    font-size: 0.8438rem;
    color: var(--fg-muted);
  }

  .panel__list {
    margin-top: 0.6rem;
    font-size: 0.9063rem;
    line-height: 1.6;
    color: color-mix(in srgb, var(--on-dark) 84%, transparent);
  }

  .panel__short {
    display: none;
  }

  @media (min-width: 60rem) {
    .panels {
      display: flex;
      height: clamp(30rem, 62vh, 38rem);
    }

    .panel {
      flex: 1 1 0;
      min-width: 0;
      transition: flex-grow 0.8s var(--ease-out);
    }

    /* The first panel stays open until another is hovered or focused. */

    .panels:not(:hover, :focus-within) .panel:first-child,
    .panel:hover,
    .panel:focus-within {
      flex-grow: 3.4;
    }

    .panel__top :global(.icon) {
      opacity: 0;
      transition: opacity 0.4s var(--ease-out);
    }

    /* Closed: the short name reads up the side. Open: the full detail fades in. */

    .panel__short {
      position: absolute;
      left: 1.4rem;
      bottom: 1.4rem;
      display: block;

      font-size: 1.5rem;
      font-weight: 740;
      font-stretch: 118%;
      line-height: 1;
      letter-spacing: -0.02em;
      white-space: nowrap;

      writing-mode: vertical-rl;
      transform: rotate(180deg);
      transition: opacity 0.35s var(--ease-out);
    }

    .panel__body {
      position: absolute;
      left: 1.4rem;
      bottom: 1.4rem;
      width: min(27rem, 38vw);

      opacity: 0;
      transform: translateY(0.75rem);
      transition:
        opacity 0.25s var(--ease-out),
        transform 0.25s var(--ease-out);
    }

    .panels:not(:hover, :focus-within) .panel:first-child .panel__short,
    .panel:hover .panel__short,
    .panel:focus-within .panel__short {
      opacity: 0;
    }

    .panels:not(:hover, :focus-within) .panel:first-child .panel__body,
    .panel:hover .panel__body,
    .panel:focus-within .panel__body,
    .panels:not(:hover, :focus-within) .panel:first-child .panel__top :global(.icon),
    .panel:hover .panel__top :global(.icon),
    .panel:focus-within .panel__top :global(.icon) {
      opacity: 1;
      transform: none;
      transition:
        opacity 0.6s var(--ease-out) 0.3s,
        transform 0.6s var(--ease-out) 0.3s;
    }
  }

  /* ------------------------------------------------------------------------
     Sectors: a rail of picture cards that runs off the right edge
     ------------------------------------------------------------------------ */

  .sectors {
    overflow: hidden;
  }

  .rail-controls {
    display: flex;
    gap: 0.5rem;
  }

  .rail-controls button {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 50%;

    background: none;
    cursor: pointer;
    transition:
      background-color 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out),
      color 0.3s var(--ease-out),
      opacity 0.3s;
  }

  .rail-controls button:hover:not(:disabled) {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }

  .rail-controls button:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .rail-controls :global(.icon) {
    width: 1.15rem;
    height: 1.15rem;
  }

  .rail {
    --edge: max(var(--gutter), (100vw - var(--max)) / 2);

    display: flex;
    gap: 0.9rem;
    margin: 0;
    padding-inline: var(--edge);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--edge);
    scrollbar-width: none;
  }

  .rail::-webkit-scrollbar {
    display: none;
  }

  .rail > li {
    flex: none;
    width: clamp(14.5rem, 22vw, 19rem);
    scroll-snap-align: start;
  }

  .sector-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    padding: 1.1rem;
    border-radius: var(--radius-lg);

    color: var(--on-dark);
    text-decoration: none;
    isolation: isolate;
  }

  .sector-card :global(.media) {
    z-index: -1;
  }

  .sector-card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, var(--ink-950) 0%, color-mix(in srgb, var(--ink-950) 20%, transparent) 55%, color-mix(in srgb, var(--ink-950) 30%, transparent));
  }

  .sector-card__icon {
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border-radius: 50%;

    background: color-mix(in srgb, var(--ink-950) 55%, transparent);
    backdrop-filter: blur(8px);
    transition:
      background-color 0.4s var(--ease-out),
      color 0.4s var(--ease-out);
  }

  .sector-card:hover .sector-card__icon {
    background: var(--accent);
    color: var(--on-accent);
