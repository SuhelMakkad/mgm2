---
import { withBase } from '../../lib/paths';

import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

import Base from '../../layouts/base.astro';
import Arrow from '../../components/arrow.astro';
import CtaBand from '../../components/cta-band.astro';
import Icon from '../../components/icon.astro';
import Media from '../../components/media.astro';

import { site } from '../../data/site';
import { image as findImage } from '../../data/images';
import { sectorById } from '../../data/sectors';
import { getProjects, statusLabels } from '../../data/projects';

export async function getStaticPaths() {
  const projects = await getProjects();

  return projects.map((project, index) => ({
    params: { id: project.id },
    props: {
      project,
      next: projects[(index + 1) % projects.length],
    },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'>;
}

const { project, next } = Astro.props;
const { title, summary, status, location, year, client, scope, image, imageAlt, sample } = project.data;

const { Content } = await render(project);

const sector = sectorById.get(project.data.sector);
const nextSector = sectorById.get(next.data.sector);

const picture = image ?? findImage(sector?.image ?? 'hero-home');
const nextPicture = next.data.image ?? findImage(nextSector?.image ?? 'hero-home');

const path = `/projects/${project.id}/`;

const crumbs = [
  { label: 'Projects', href: '/projects/' },
  { label: title, href: path },
];

const facts = [
  { icon: 'activity', label: 'Status', value: statusLabels[status] },
  { icon: sector?.icon ?? 'buildings', label: 'Category', value: sector?.name },
  { icon: 'map-pin', label: 'Location', value: location },
  { icon: 'calendar-blank', label: 'Year', value: year },
  { icon: 'handshake', label: 'Client', value: client },
].filter((fact) => fact.value);
---

<Base title={`${title}, ${location}`} description={summary} ogType="article" breadcrumbs={crumbs} noindex={sample}>
  <section class="cover theme-dark">
    <div class="cover__backdrop">
      <Media src={picture} alt={imageAlt ?? title} ratio="fill" sizes="100vw" eager />
    </div>

    <div class="container cover__inner">
      <nav class="crumbs rise" aria-label="Breadcrumb">
        <ol role="list">
          <li>
            <a href={withBase('/')}>Home</a>
          </li>

          <li>
            <a href={withBase('/projects/')}>Projects</a>
          </li>

          <li>
            <span aria-current="page">{title}</span>
          </li>
        </ol>
      </nav>

      <p class="cover__tags rise" style="--d:1">
        <span class="tag" data-status={status}>{statusLabels[status]}</span>
        {sample && <span class="tag tag--sample">Sample</span>}
      </p>

      <h1 class="h1">
        <span class="line-mask" style="--d:1"><span>{title}</span></span>
      </h1>

      <dl class="cover__facts rise" style="--d:4">
        {
          facts.map((fact) => (
            <div>
              <dt>
                <Icon name={fact.icon} />
                {fact.label}
              </dt>

              <dd>{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="container project">
      <div class="project__body" data-reveal>
        <p class="lede project__summary">{summary}</p>

        {
          sample && (
            <p class="project__note">
              <Icon name="info" />
              Placeholder entry for layout purposes. It does not describe a real {site.shortName} project, and the picture is illustrative.
            </p>
          )
        }

        <div class="prose">
          <Content />
        </div>
      </div>

      {
        scope.length > 0 && (
          <aside class="project__scope" data-reveal style="--i:1">
            <h2 class="label">Scope of work</h2>

            <ul role="list">
              {scope.map((item) => (
                <li>
                  <Icon name="check-circle-fill" />
                  {item}
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>
  </section>

  <nav class="next theme-dark" aria-label="Next project">
    <a class="next__link" href={withBase(`/projects/${next.id}/`)} rel="next">
      <Media src={nextPicture} alt="" ratio="fill" sizes="100vw" />

      <span class="container next__inner">
        <span class="label">Next project</span>

        <span class="next__title">
          <strong class="h1">{next.data.title}</strong>
          <Arrow />
        </span>

        <span class="next__meta">{statusLabels[next.data.status]} · {nextSector?.name}</span>
      </span>
    </a>
  </nav>

  <CtaBand />
</Base>

<style>
  /* Cover: the project photograph, full width, with the facts along its foot. */

  .cover {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(52rem, 88svh);
    overflow: hidden;
    padding-block: calc(var(--header-h) + 4rem) clamp(2rem, 1.5rem + 2.5vw, 3.5rem);
    background: var(--ink-950);
  }

  .cover__backdrop {
    position: absolute;
    inset: 0;
    animation: cover-settle 2.4s var(--ease-out) both;
  }

  .cover__backdrop::after {
    content: '';
    position: absolute;
    inset: 0;

    background:
      linear-gradient(to top, var(--ink-950) 4%, color-mix(in srgb, var(--ink-950) 62%, transparent) 45%, color-mix(in srgb, var(--ink-950) 18%, transparent) 100%),
      linear-gradient(to bottom, color-mix(in srgb, var(--ink-950) 50%, transparent), transparent 24%);
  }

  @keyframes cover-settle {
    from {
      transform: scale(1.08);
    }
  }

  .cover__inner {
    position: relative;
    display: grid;
    justify-items: start;
    gap: 1.25rem;
  }

  .cover__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .cover__tags .tag {
    background: var(--surface);
    color: var(--text);
  }

  .cover__tags .tag--sample {
    background: color-mix(in srgb, var(--ink-950) 55%, transparent);
    border-color: color-mix(in srgb, var(--on-dark) 55%, transparent);
    color: var(--on-dark);
  }

  .cover__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 2rem;
    width: 100%;
    margin: clamp(0.75rem, 2vw, 1.5rem) 0 0;
    padding-top: clamp(1.25rem, 2.5vw, 2rem);
    border-top: 1px solid var(--line-strong);
  }

  .cover__facts div {
    display: grid;
    gap: 0.3rem;
  }

  .cover__facts dt {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;

    font-size: 0.75rem;
    font-weight: 650;
    font-stretch: 110%;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .cover__facts :global(.icon) {
    width: 1.05rem;
    height: 1.05rem;
    color: var(--accent);
  }

  .cover__facts dd {
    font-size: 1.0625rem;
    font-weight: 650;
    font-stretch: 108%;
  }

  @media (min-width: 52rem) {
    .cover__facts {
      grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    }
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;

    font-size: 0.8125rem;
    color: color-mix(in srgb, var(--on-dark) 70%, transparent);
  }

  .crumbs li + li::before {
    content: '/';
    margin-right: 0.5rem;
    opacity: 0.5;
  }

  .crumbs a {
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--fg);
  }

  /* Body */

  .project {
    display: grid;
    gap: 3rem;
    align-items: start;
  }

  .project__body {
    display: grid;
    gap: 2rem;
  }

  .project__summary {
    max-width: 30em;
    font-size: var(--step-2);
    font-weight: 560;
    line-height: 1.35;
    letter-spacing: -0.012em;
    color: var(--fg);
  }

  .project__note {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    max-width: 40em;
    padding: 0.95rem 1.1rem;
    border: 1px dashed var(--line-strong);
    border-radius: 10px;

    font-size: 0.875rem;
    color: var(--fg-muted);
  }

  .project__note :global(.icon) {
    width: 1.2rem;
    height: 1.2rem;
    margin-top: 0.1rem;
  }

  .project__scope {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .project__scope ul {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }

  .project__scope li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-weight: 560;
  }

  .project__scope li :global(.icon) {
    width: 1.3rem;
    height: 1.3rem;
    color: var(--accent-text);
  }

  @media (min-width: 60rem) {
    .project {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
      gap: clamp(3rem, 7vw, 7rem);
    }

    .project__scope {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }

  /* Next project */

  .next__link {
    position: relative;
    display: block;
    overflow: hidden;
    padding-block: clamp(4rem, 9vw, 8rem);
    text-decoration: none;
    isolation: isolate;
  }

  .next__link :global(.media) {
    z-index: -1;
  }

  .next__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--ink-950) 74%, transparent);
    transition: background-color 0.6s var(--ease-out);
  }

  .next__link:hover::after {
    background: color-mix(in srgb, var(--ink-950) 52%, transparent);
  }

  .next__inner {
    display: grid;
    justify-items: start;
    gap: 1rem;
  }

  .next__title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    width: 100%;
  }

  .next__title :global(svg) {
    flex: none;
    width: clamp(2rem, 4vw, 3.5rem);
    height: auto;
    color: var(--accent);
    transition: transform 0.6s var(--ease-out);
  }

  .next__link:hover .next__title :global(svg) {
    transform: translateX(0.75rem);
  }

  .next__meta {
    color: color-mix(in srgb, var(--on-dark) 78%, transparent);
  }
</style>
