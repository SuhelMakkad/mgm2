---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import CtaBand from '../../components/CtaBand.astro';
import PageHero from '../../components/PageHero.astro';
import Plate from '../../components/Plate.astro';

import { site } from '../../data/site';
import { sectorById, drawings } from '../../data/sectors';
import { getProjects, statusLabels } from '../../data/projects';

export async function getStaticPaths() {
  const projects = await getProjects();

  return projects.map((project, index) => ({
    params: { id: project.id },
    props: {
      project,
      next: projects[(index + 1) % projects.length],
    },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'>;
}

const { project, next } = Astro.props;
const { title, summary, status, location, year, client, scope, image, imageAlt, sample } = project.data;

const { Content } = await render(project);

const sector = sectorById.get(project.data.sector);
const nextSector = sectorById.get(next.data.sector);

const path = `/projects/${project.id}/`;

const crumbs = [
  { label: 'Projects', href: '/projects/' },
  { label: title, href: path },
];

const facts = [
  { label: 'Status', value: statusLabels[status] },
  { label: 'Category', value: sector?.name },
  { label: 'Location', value: location },
  { label: 'Year', value: year },
  { label: 'Client', value: client },
].filter((fact) => fact.value);
---

<Base
  title={`${title}, ${location}`}
  description={summary}
  ogType="article"
  breadcrumbs={crumbs}
  noindex={sample}
>
  <PageHero label={`${statusLabels[status]} · ${sector?.name ?? 'Project'}`} title={title} lede={summary} crumbs={crumbs} />

  <section class="section">
    <div class="container">
      <div data-reveal>
        <Plate drawing={sector?.icon ?? drawings.crane} image={image} alt={imageAlt ?? title} ratio="21 / 9" sizes="100vw" eager class="project__plate" />
      </div>

      <div class="project">
        <aside class="project__facts" data-reveal>
          <dl>
            {
              facts.map((fact) => (
                <div>
                  <dt>{fact.label}</dt>
                  <dd>{fact.value}</dd>
                </div>
              ))
            }
          </dl>

          {
            scope.length > 0 && (
              <div class="project__scope">
                <h2>Scope of work</h2>

                <ul role="list">
                  {scope.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            )
          }
        </aside>

        <div class="project__body" data-reveal style="--i:1">
          {
            sample && (
              <p class="project__note">
                <span class="tag tag--sample">Sample</span>
                Placeholder entry for layout purposes. It does not describe a real {site.shortName} project.
              </p>
            )
          }

          <div class="prose">
            <Content />
          </div>
        </div>
      </div>
    </div>
  </section>

  <nav class="next theme-tint" aria-label="Next project">
    <a class="container next__link" href={`/projects/${next.id}/`} rel="next">
      <span class="next__hint">Next project</span>

      <span class="next__title">
        <strong class="h2">{next.data.title}</strong>
        <Arrow />
      </span>

      <span class="muted">{statusLabels[next.data.status]} · {nextSector?.name}</span>
    </a>
  </nav>

  <CtaBand />
</Base>

<style>
  .project {
    display: grid;
    gap: 3rem;
    align-items: start;
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .project__facts {
    display: grid;
    gap: 2rem;
  }

  .project__facts dl {
    margin: 0;
    border-top: 1px solid var(--line-strong);
  }

  .project__facts dl div {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.9375rem;
  }

  .project__facts dt,
  .project__scope h2 {
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.9;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .project__scope ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.75rem 0 0;
  }

  .project__scope li {
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    font-size: 0.875rem;
  }

  .project__body {
    display: grid;
    gap: 2rem;
  }

  .project__note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 0.9rem;
    max-width: 40em;
    padding: 0.9rem 1rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);

    font-size: 0.875rem;
    color: var(--fg-muted);
  }

  @media (max-width: 39.99rem) {
    :global(.project__plate) {
      --ratio: 4 / 3 !important;
    }
  }

  @media (min-width: 60rem) {
    .project {
      grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
      gap: clamp(3rem, 7vw, 7rem);
    }

    .project__facts {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }

  /* Next project */

  .next {
    border-top: 1px solid var(--line);
  }

  .next__link {
    display: grid;
    gap: 0.5rem;
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
    text-decoration: none;
  }

  .next__hint {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .next__title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .next__title :global(svg) {
    flex: none;
    width: clamp(1.75rem, 3vw, 2.5rem);
    height: auto;
    color: var(--accent);
    transition: transform 0.6s var(--ease-out);
  }

  .next__link:hover .next__title :global(svg) {
    transform: translateX(0.6rem);
  }
</style>
