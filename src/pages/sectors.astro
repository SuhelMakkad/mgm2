---
import Base from '../layouts/base.astro';
import CtaBand from '../components/cta-band.astro';
import Icon from '../components/icon.astro';
import Media from '../components/media.astro';
import PageHero from '../components/page-hero.astro';

import { image } from '../data/images';
import { sectors } from '../data/sectors';
import { getProjects } from '../data/projects';

const projects = await getProjects();

const projectCount = (sectorId: string) => projects.filter((project) => project.data.sector === sectorId).length;

const crumbs = [{ label: 'Sectors', href: '/sectors/' }];
---

<Base
  title="Sectors We Serve"
  description={`${sectors.length} sectors served across the UAE, from infrastructure, healthcare and fuel facilities to palatial villas, hospitality and houses of worship.`}
  breadcrumbs={crumbs}
>
  <PageHero
    label="Sectors"
    title={`${sectors.length} sectors. One standard of work.`}
    lede="Each sector brings its own rules, risks and expectations. Nearly five decades in the UAE have taught us to respect all of them."
    backdrop="sector-infrastructure"
    crumbs={crumbs}
  />

  <section class="section">
    <div class="container">
      <ul class="sectors" role="list">
        {
          sectors.map((sector, index) => (
            <li class="sector" id={sector.id} data-reveal style={`--i:${index % 3}`}>
              <div class="sector__media">
                <Media src={image(sector.image)} alt="" ratio="3 / 2" sizes="(min-width: 72rem) 30vw, (min-width: 44rem) 48vw, 100vw" />

                <span class="sector__icon">
                  <Icon name={sector.icon} />
                </span>
              </div>

              <div class="sector__body">
                <h2 class="h3">{sector.name}</h2>
                <p class="muted">{sector.description}</p>

                {projectCount(sector.id) > 0 && (
                  <a class="sector__link" href={`/projects/?sector=${sector.id}`}>
                    View projects
                    <Icon name="arrow-right-bold" />
                  </a>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand title="Working in one of these sectors?" text="Tell us about the project and the environment it sits in." />
</Base>

<style>
  .sectors {
    display: grid;
    gap: 2.75rem 1.5rem;
    margin: 0;
  }

  .sector {
    display: grid;
    gap: 1.1rem;
    align-content: start;
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }

  .sector__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
  }

  .sector__media :global(img) {
    transition: transform 1.4s var(--ease-out);
  }

  .sector:hover .sector__media :global(img) {
    transform: scale(1.06);
  }

  .sector__icon {
    position: absolute;
    left: 0.9rem;
    bottom: 0.9rem;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;

    background: var(--surface);
    color: var(--text);
    transition:
      background-color 0.4s var(--ease-out),
      color 0.4s var(--ease-out);
  }

  .sector:hover .sector__icon,
  .sector:target .sector__icon {
    background: var(--accent);
    color: var(--on-accent);
  }

  /* Arriving from a link on another page: mark the sector that was asked for. */

  .sector:target .sector__media {
    outline: 3px solid var(--accent);
    outline-offset: 4px;
  }

  .sector__body {
    display: grid;
    gap: 0.45rem;
    justify-items: start;
  }

  .sector__body .muted {
    font-size: 0.9688rem;
  }

  .sector__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.3rem;

    font-size: 0.875rem;
    font-weight: 650;
    color: var(--accent-text);
    text-decoration: none;
  }

  .sector__link :global(.icon) {
    width: 0.95rem;
    height: 0.95rem;
    transition: transform 0.35s var(--ease-out);
  }

  .sector__link:hover :global(.icon) {
    transform: translateX(0.25rem);
  }

  @media (min-width: 44rem) {
    .sectors {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 72rem) {
    .sectors {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
