---
import Base from '../layouts/base.astro';
import Arrow from '../components/arrow.astro';
import Icon from '../components/icon.astro';
import Media from '../components/media.astro';
import PageHero from '../components/page-hero.astro';
import SectionHead from '../components/section-head.astro';

import { site, contact } from '../data/site';
import { image } from '../data/images';
import { serviceGroups } from '../data/services';

const crumbs = [{ label: 'Contact us', href: '/contact/' }];

const enquiryTypes = [
  { value: 'project', label: 'Project enquiry (client or consultant)' },
  { value: 'subcontractor', label: 'Subcontractor registration' },
  { value: 'supplier', label: 'Supplier registration' },
  { value: 'careers', label: 'Careers' },
  { value: 'general', label: 'General enquiry' },
];

const registrationSteps = [
  { icon: 'paper-plane-tilt', title: 'Send the form', text: 'Choose subcontractor or supplier registration and tell us about your company and trade.' },
  { icon: 'magnifying-glass', title: 'We review your details', text: 'Our procurement team checks the enquiry against current and upcoming requirements.' },
  { icon: 'link', title: 'Receive your registration link', text: 'On successful review we email you a link to complete registration as an approved vendor.' },
];

const telHref = contact.phone ? `tel:${contact.phone.replace(/[^\d+]/g, '')}` : '';
---

<Base
  title="Contact Us"
  description="Contact Al Madar MGM Construction LLC in Dubai for project enquiries, subcontractor and supplier registration, and careers."
  breadcrumbs={crumbs}
  schema={[{ '@type': 'ContactPage', name: `Contact ${site.name}`, url: new URL('/contact/', Astro.site).href }]}
>
  <PageHero label="Contact us" title="Tell us what you are building." backdrop="contact-office" position="center 60%" crumbs={crumbs} />

  <section class="section">
    <div class="container contact">
      <div class="contact__form">
        <SectionHead label="Enquiries" title="Send us a message." />

        <form class="form" method="post" action={contact.formEndpoint || undefined} data-form data-email={contact.email} novalidate>
          <div class="field field--full">
            <label for="type">I am getting in touch about</label>

            <span class="field__select">
              <select id="type" name="type" required>
                {enquiryTypes.map((type) => <option value={type.value}>{type.label}</option>)}
              </select>

              <Icon name="caret-down-bold" />
            </span>
          </div>

          <div class="field">
            <label for="name">Full name</label>
            <input id="name" name="name" type="text" autocomplete="name" required />
          </div>

          <div class="field">
            <label for="company">Company</label>
            <input id="company" name="company" type="text" autocomplete="organization" />
          </div>

          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" required />
          </div>

          <div class="field">
            <label for="phone">Phone</label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" />
          </div>

          <div class="field field--full" data-vendor-field hidden>
            <label for="trade">Trade or product category</label>
            <input id="trade" name="trade" type="text" list="trades" placeholder="e.g. MEP, joinery, ready-mix concrete" />

            <datalist id="trades">
              {serviceGroups.flatMap((group) => group.services).map((service) => <option value={service.name} />)}
            </datalist>
          </div>

          <div class="field field--full">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="6" required></textarea>
          </div>

          {/* Honeypot: hidden from people, tempting to bots. */}
          <div class="visually-hidden" aria-hidden="true">
            <label for="website">Leave this field empty</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="form__foot field--full">
            <button class="btn" type="submit">
              Send enquiry
              <Arrow />
            </button>

            <p class="form__hint" data-vendor-field hidden>Once your details are reviewed, we will email you a registration link.</p>
          </div>

          <p class="form__status field--full" role="status" aria-live="polite" data-status hidden></p>
        </form>
      </div>

      <aside class="contact__aside" data-reveal>
        <div class="contact__photo">
          <Media src={image('contact-office')} alt="A modern office building at dusk" ratio="16 / 10" sizes="(min-width: 64rem) 34vw, 100vw" />
        </div>

        <ul class="channels" role="list" id="locations">
          <li>
            <Icon name="envelope-simple" />

            <span>
              <small>Email</small>
              <a href={`mailto:${contact.email}`}>{contact.email}</a>
            </span>
          </li>

          {
            contact.phone && (
              <li>
                <Icon name="phone" />

                <span>
                  <small>Phone</small>
                  <a href={telHref}>{contact.phone}</a>
                </span>
              </li>
            )
          }

          <li>
            <Icon name="clock" />

            <span>
              <small>Hours</small>
              {contact.hours}
            </span>
          </li>

          {
            contact.locations.map((location) => (
              <li>
                <Icon name="map-pin" />

                <address>
                  <small>{location.name}</small>
                  {location.lines.join(', ')}

                  <a class="channels__map" href={location.mapUrl} target="_blank" rel="noopener">
                    Open in Maps
                    <Icon name="arrow-up-right-bold" />
                  </a>
                </address>
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </section>

  <section class="section theme-tint" id="register">
    <div class="container">
      <div class="register__head">
        <SectionHead
          label="Subcontractors & suppliers"
          title="Register to work with us."
          lede="We keep a register of approved subcontractors and suppliers. It starts with the contact form."
        />

        <a class="btn" href="#type" data-preset="subcontractor" data-reveal>
          Start registration
          <Arrow />
        </a>
      </div>

      <ol class="process" role="list">
        {
          registrationSteps.map((step, index) => (
            <li data-reveal style={`--i:${index}`}>
              <span class="process__number">{index + 1}</span>

              <Icon name={step.icon} />
              <h3 class="h3">{step.title}</h3>
              <p class="muted">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="careers theme-dark" id="careers">
    <div class="careers__backdrop" aria-hidden="true">
      <Media src={image('team-site')} alt="" ratio="fill" sizes="100vw" position="center 35%" />
    </div>

    <div class="container careers__inner">
      <SectionHead
        label="Careers"
        title="Build your career where experience is valued."
        lede="Several of our team have been with us for decades. We are always glad to hear from engineers, supervisors, craftsmen and professionals who share our standards."
      />

      <div class="careers__buttons" data-reveal>
        <a class="btn" href={`mailto:${contact.careersEmail}?subject=${encodeURIComponent('Career enquiry')}`}>
          Email your CV
          <Arrow />
        </a>

        <a class="btn btn--ghost" href="#type" data-preset="careers">Use the contact form</a>
      </div>
    </div>
  </section>
</Base>

<script>
  /**
   * Contact form. Shows the vendor fields for subcontractor and supplier enquiries,
   * then submits to the configured endpoint, or opens a pre-filled email when none is set.
   */

  const form = document.querySelector<HTMLFormElement>('[data-form]');

  if (form) {
    const type = form.querySelector<HTMLSelectElement>('#type')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

    const vendorFields = [...form.querySelectorAll<HTMLElement>('[data-vendor-field]')];
    const vendorTypes = new Set(['subcontractor', 'supplier']);

    const syncVendorFields = () => {
      const isVendor = vendorTypes.has(type.value);

      vendorFields.forEach((field) => (field.hidden = !isVendor));
    };

    const say = (message: string, tone: 'ok' | 'error') => {
      status.textContent = message;
      status.dataset.tone = tone;
      status.hidden = false;
    };

    // Links elsewhere on the page can preselect an enquiry type.
    for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-preset]')) {
      link.addEventListener('click', () => {
        type.value = link.dataset.preset ?? type.value;
        syncVendorFields();
      });
    }

    // So can the URL, e.g. /contact/?type=supplier.
    const preset = new URLSearchParams(location.search).get('type');

    if (preset && [...type.options].some((option) => option.value === preset)) type.value = preset;

    type.addEventListener('change', syncVendorFields);
    syncVendorFields();

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const data = new FormData(form);

      // A filled honeypot means a bot. Pretend it worked.
      if (data.get('website')) {
        form.reset();
        return;
      }

      data.delete('website');

      const isVendor = vendorTypes.has(type.value);
      const endpoint = form.getAttribute('action');

      if (!endpoint) {
        const lines = [...data.entries()].filter(([, value]) => value).map(([key, value]) => `${key}: ${value}`);
        const subject = `Website enquiry: ${type.selectedOptions[0].textContent}`;

        location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n'))}`;

        say('Your email app should now open with your enquiry ready to send.', 'ok');
        return;
      }

      submit.disabled = true;

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });

        if (!response.ok) throw new Error(`Request failed with ${response.status}`);

        form.reset();
        syncVendorFields();

        say(
          isVendor
            ? 'Thank you. Your enquiry has been received, and a registration link will follow by email once it has been reviewed.'
            : 'Thank you. Your enquiry has been received and we will be in touch shortly.',
          'ok',
        );
      } catch {
        say(`Sorry, your enquiry could not be sent. Please email us at ${form.dataset.email} instead.`, 'error');
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>

<style>
  .contact {
    display: grid;
    gap: 3.5rem;
    align-items: start;
  }

  .contact__form {
    display: grid;
    gap: 2.5rem;
  }

  /* Form */

  .form {
    display: grid;
    gap: 1.4rem 1.1rem;
  }

  .field {
    display: grid;
    gap: 0.45rem;
  }

  .field[hidden],
  .form [hidden] {
    display: none;
  }

  .field label {
    font-size: 0.8125rem;
    font-weight: 650;
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 3.35rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: 10px;

    background: var(--surface);
    transition:
      border-color 0.25s var(--ease-out),
      box-shadow 0.25s var(--ease-out);
  }

  .field textarea {
    resize: vertical;
    line-height: 1.55;
  }

  .field__select {
    position: relative;
    display: flex;
    align-items: center;
  }

  .field__select select {
    appearance: none;
    padding-right: 2.75rem;
  }

  .field__select :global(.icon) {
    position: absolute;
    right: 1.1rem;
    width: 0.9rem;
    height: 0.9rem;
    pointer-events: none;
  }

  .field input::placeholder {
    color: var(--muted);
    opacity: 0.75;
  }

  .field :is(input, select, textarea):hover {
    border-color: var(--text);
  }

  .field :is(input, select, textarea):focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 28%, transparent);
  }

  .form__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .form__hint {
    font-size: 0.875rem;
    color: var(--fg-muted);
  }

  .form__status {
    padding: 1rem 1.1rem;
    border-left: 3px solid var(--text);
    border-radius: 0 10px 10px 0;
    background: var(--paper-2);
    font-size: 0.9375rem;
  }

  .form__status[data-tone='error'] {
    border-left-color: #c0301f;
  }

  .form :global(button:disabled) {
    opacity: 0.6;
    cursor: progress;
  }

  @media (min-width: 40rem) {
    .form {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .field--full {
      grid-column: 1 / -1;
    }
  }

  /* Aside: a picture and the direct channels */

  .contact__aside {
    display: grid;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .channels {
    display: grid;
    margin: 0;
    padding: 0.5rem clamp(1.25rem, 2.5vw, 1.75rem) 1rem;
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }

  .channels li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line);
  }

  .channels li:last-child {
    border-bottom: 0;
  }

  .channels li > :global(.icon) {
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 0.15rem;
    color: var(--accent-text);
  }

  .channels li > :is(span, address) {
    display: grid;
    gap: 0.1rem;
    justify-items: start;
    font-weight: 560;
    overflow-wrap: anywhere;
  }

  .channels small {
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .channels a {
    text-decoration-color: var(--accent);
  }

  .channels__map {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.5rem;

    font-size: 0.875rem;
    font-weight: 650;
    color: var(--accent-text);
    text-decoration: none;
  }

  .channels__map :global(.icon) {
    width: 0.9rem;
    height: 0.9rem;
  }

  @media (min-width: 64rem) {
    .contact {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
      gap: clamp(3rem, 6vw, 6rem);
    }

    .contact__aside {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }

  /* Registration process */

  .register__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-bottom: clamp(2.25rem, 4.5vw, 3.5rem);
  }

  .process {
    display: grid;
    gap: 0.9rem;
    margin: 0;
  }

  .process li {
    position: relative;
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .process li > :global(.icon) {
    width: 2.25rem;
    height: 2.25rem;
    margin-bottom: 0.75rem;
    color: var(--accent-text);
  }

  .process__number {
    position: absolute;
    top: 1.1rem;
    right: 1.4rem;

    font-size: 3.25rem;
    font-weight: 800;
    font-stretch: 125%;
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--paper-3);
  }

  .process .muted {
    font-size: 0.9688rem;
  }

  @media (min-width: 52rem) {
    .process {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Careers */

  .careers {
    position: relative;
    overflow: hidden;
    padding-block: var(--section);
    background: var(--ink-950);
    scroll-margin-top: var(--header-h);
  }

  .careers__backdrop {
    position: absolute;
    inset: 0;
  }

  .careers__backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(95deg, var(--ink-950) 18%, color-mix(in srgb, var(--ink-950) 62%, transparent) 100%);
  }

  .careers__inner {
    position: relative;
    display: grid;
    gap: 2.25rem;
  }

  .careers__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
