---
import Base from '../layouts/base.astro';
import BuildStory from '../components/build-story.astro';
import CtaBand from '../components/cta-band.astro';
import Icon from '../components/icon.astro';
import Media from '../components/media.astro';
import PageHero from '../components/page-hero.astro';

import { site } from '../data/site';
import { image } from '../data/images';
import { serviceGroups, serviceCount } from '../data/services';

const crumbs = [{ label: 'Services', href: '/services/' }];

const catalogue = {
  '@type': 'OfferCatalog',
  name: `${site.name} services`,
  itemListElement: serviceGroups.map((group) => ({
    '@type': 'OfferCatalog',
    name: group.title,
    itemListElement: group.services.map((service) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: service.name, description: service.description },
    })),
  })),
};
---

<Base
  title="Construction Services in Dubai, UAE"
  description={`${serviceCount} services from one Dubai contractor: civil construction, building contracting, MEP, design and build, fit-out, maintenance and specialist finishes.`}
  breadcrumbs={crumbs}
  schema={[catalogue]}
>
  <PageHero
    label="Services"
    title="From foundations to gold leaf."
    lede={`${serviceCount} services across four disciplines, from one contractor.`}
    backdrop="svc-construction"
    crumbs={crumbs}
  >
    <ul class="index" role="list">
      {
        serviceGroups.map((group) => (
          <li>
            <a href={`#${group.id}`}>
              <Icon name={group.icon} />
              {group.title}
            </a>
          </li>
        ))
      }
    </ul>
  </PageHero>

  <BuildStory title="How a building comes together." />

  {
    serviceGroups.map((group, groupIndex) => (
      <section class:list={['section group', { 'theme-tint': groupIndex % 2 === 1 }]} id={group.id}>
        <div class="container">
          <header class="group__head" data-side={groupIndex % 2 === 0 ? 'left' : 'right'}>
            <div class="group__media" data-reveal="wipe">
              <Media src={image(group.image)} alt="" ratio="16 / 10" sizes="(min-width: 64rem) 50vw, 100vw" />
              <span class="group__letter">{group.letter}</span>
            </div>

            <div class="group__intro" data-reveal>
              <p class="label">{group.services.length} services</p>
              <h2 class="h2">{group.title}</h2>
              <p class="lede">{group.summary}</p>
            </div>
          </header>

          <ul class="services" role="list">
            {group.services.map((service, index) => (
              <li class="service" data-reveal style={`--i:${index % 3}`}>
                <span class="service__icon">
                  <Icon name={service.icon} />
                </span>

                <h3 class="h3">{service.name}</h3>
                <p class="muted">{service.description}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <CtaBand title="Need something that is not on the list?" text="Many of our projects start with an unusual brief. Tell us what you need." />
</Base>

<style>
  .index {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.5rem 0 0;
  }

  .index a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 1.05rem 0.55rem 0.8rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;

    background: color-mix(in srgb, var(--ink-950) 40%, transparent);
    backdrop-filter: blur(8px);

    font-size: 0.875rem;
    font-weight: 560;
    text-decoration: none;
    transition:
      background-color 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out),
      color 0.3s var(--ease-out);
  }

  .index :global(.icon) {
    width: 1.2rem;
    height: 1.2rem;
    color: var(--accent);
    transition: color 0.3s var(--ease-out);
  }

  .index a:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }

  .index a:hover :global(.icon) {
    color: var(--on-accent);
  }

  /* One discipline: a picture and an introduction, then its services as cards. */

  .group {
    scroll-margin-top: var(--header-h);
  }

  .group__head {
    display: grid;
    gap: 2rem;
    align-items: center;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .group__media {
    position: relative;
  }

  .group__media :global(.media) {
    border-radius: var(--radius-lg);
  }

  .group__letter {
    position: absolute;
    top: 1rem;
    left: 1rem;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;

    background: var(--accent);
    color: var(--on-accent);
    font-size: 1.125rem;
    font-weight: 780;
    font-stretch: 118%;
  }

  .group__intro {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
  }

  @media (min-width: 60rem) {
    .group__head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(3rem, 6vw, 6rem);
    }

    .group__head[data-side='right'] .group__media {
      order: 2;
    }
  }

  .services {
    display: grid;
    gap: 0.9rem;
    margin: 0;
  }

  .service {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding: 1.6rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);

    background: var(--surface);
    transition:
      border-color 0.4s var(--ease-out),
      transform 0.4s var(--ease-out),
      box-shadow 0.4s var(--ease-out);
  }

  .service__icon {
    display: grid;
    place-items: center;
    width: 3.1rem;
    height: 3.1rem;
    margin-bottom: 0.6rem;
    border-radius: 50%;

    background: var(--paper-2);
    color: var(--accent-text);
    transition:
      background-color 0.4s var(--ease-out),
      color 0.4s var(--ease-out);
  }

  .service .muted {
    font-size: 0.9688rem;
  }

  .service:hover {
    border-color: var(--accent);
    transform: translateY(-0.25rem);
    box-shadow: 0 18px 40px -24px color-mix(in srgb, var(--text) 45%, transparent);
  }

  .service:hover .service__icon {
    background: var(--accent);
    color: var(--on-accent);
  }

  @media (min-width: 40rem) {
    .services {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .services {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
