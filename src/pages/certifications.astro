---
import { withBase } from '../lib/paths';

import Base from '../layouts/base.astro';
import Arrow from '../components/arrow.astro';
import CtaBand from '../components/cta-band.astro';
import Icon from '../components/icon.astro';
import Media from '../components/media.astro';
import PageHero from '../components/page-hero.astro';

import { image } from '../data/images';
import { certifications } from '../data/certifications';

const crumbs = [{ label: 'Certifications', href: '/certifications/' }];
---

<Base
  title="Certifications"
  description="ISO certification, UAE In-Country Value (ICV) certification and other approvals held by Al Madar MGM Construction LLC, Dubai."
  breadcrumbs={crumbs}
>
  <PageHero
    label="Certifications"
    title="Standards we are measured against."
    lede="Independent certification gives clients, consultants and partners assurance that our work is checked against recognised benchmarks."
    backdrop="hse"
    crumbs={crumbs}
  />

  <section class="section">
    <div class="container">
      <ul class="certificates" role="list">
        {
          certifications.map((certification, index) => (
            <li class="certificate" id={certification.id} data-reveal style={`--i:${index}`}>
              <span class="certificate__icon">
                <Icon name={certification.icon} />
              </span>

              <h2 class="h3">{certification.name}</h2>
              <p class="muted">{certification.description}</p>

              {certification.details.length > 0 && (
                <dl class="certificate__details">
                  {certification.details.map((detail) => (
                    <div>
                      <dt>{detail.label}</dt>
                      <dd>{detail.value}</dd>
                    </div>
                  ))}
                </dl>
              )}

              {certification.document ? (
                <a class="arrow-link" href={withBase(certification.document)}>
                  View certificate
                  <Arrow />
                </a>
              ) : (
                <a class="arrow-link" href={withBase('/contact/')}>
                  Request a copy
                  <Arrow />
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="principle theme-dark">
    <div class="principle__media" data-reveal="wipe">
      <Media src={image('team-site')} alt="Construction professionals walking across a site" ratio="fill" sizes="(min-width: 60rem) 50vw, 100vw" />
    </div>

    <div class="principle__body">
      <Icon name="quotes-fill" />

      <blockquote class="h2" data-reveal>
        <p>
          We firmly believe that successful construction is measured not only by the quality of what we build, but also by how responsibly we build it.
        </p>
      </blockquote>

      <p class="label" data-reveal style="--i:1">How we build</p>
    </div>
  </section>

  <CtaBand title="Prequalifying us for a tender?" text="We can supply certificates, registrations and supporting documents for your file." />
</Base>

<style>
  .certificates {
    display: grid;
    gap: 1rem;
    margin: 0;
  }

  .certificate {
    display: grid;
    gap: 0.9rem;
    align-content: start;
    justify-items: start;
    padding: clamp(1.75rem, 3vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);

    background: var(--surface);
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
    transition:
      border-color 0.4s var(--ease-out),
      transform 0.4s var(--ease-out);
  }

  .certificate:hover {
    border-color: var(--accent);
    transform: translateY(-0.25rem);
  }

  .certificate__icon {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    margin-bottom: 0.75rem;
    border-radius: 50%;

    background: var(--accent);
    color: var(--on-accent);
  }

  .certificate__icon :global(.icon) {
    width: 2rem;
    height: 2rem;
  }

  .certificate .arrow-link {
    margin-top: 0.75rem;
  }

  .certificate__details {
    display: grid;
    width: 100%;
    margin: 0.5rem 0 0;
    border-top: 1px solid var(--line);
  }

  .certificate__details div {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.9375rem;
  }

  .certificate__details dt {
    color: var(--fg-muted);
  }

  @media (min-width: 56rem) {
    .certificates {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Principle: picture on one side, statement on the other. */

  .principle {
    display: grid;
  }

  .principle__media {
    position: relative;
    min-height: 20rem;
  }

  .principle__body {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 1.75rem;
    padding: clamp(3.5rem, 8vw, 7.5rem) var(--gutter);
  }

  .principle__body > :global(.icon) {
    width: 3.25rem;
    height: 3.25rem;
    color: var(--accent);
  }

  .principle blockquote {
    max-width: 18em;
  }

  @media (min-width: 60rem) {
    .principle {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .principle__body {
      padding-inline: clamp(3rem, 6vw, 6rem);
    }
  }
</style>
