---
/**
 * Review tool for comparing colour palettes on the real pages.
 *
 * The layout only includes it in development, or in a build made with
 * PUBLIC_PALETTE_SWITCHER=true. A palette can also be forced with ?palette=<name>.
 * Once a palette is chosen, set it in src/data/site.ts; this component can then be deleted.
 */
import { site } from '../data/site';

const palettes = [
  { id: 'ember', name: 'Ember', swatch: '#ff5a1f' },
  { id: 'cobalt', name: 'Cobalt', swatch: '#2f5bff' },
  { id: 'crimson', name: 'Crimson', swatch: '#dc2430' },
  { id: 'highvis', name: 'High-vis', swatch: '#ffc61a' },
];
---

<div class="palette-switcher" data-palette-switcher data-default={site.palette}>
  <span>Palette</span>

  {
    palettes.map((palette) => (
      <button type="button" data-value={palette.id} title={palette.name} aria-label={`Use the ${palette.name} palette`}>
        <i style={`background:${palette.swatch}`} />
      </button>
    ))
  }
</div>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const widget = document.querySelector('[data-palette-switcher]');

    const apply = (value) => {
      root.dataset.palette = value;

      for (const button of widget.querySelectorAll('button')) {
        button.toggleAttribute('data-active', button.dataset.value === value);
      }
    };

    const fromUrl = new URLSearchParams(location.search).get('palette');

    apply(fromUrl ?? localStorage.getItem('palette') ?? widget.dataset.default);

    widget.addEventListener('click', (event) => {
      const button = event.target.closest('button');

      if (!button) return;

      localStorage.setItem('palette', button.dataset.value);
      apply(button.dataset.value);
    });
  })();
</script>

<style>
  .palette-switcher {
    position: fixed;
    left: 1rem;
    bottom: 1rem;
    z-index: 90;

    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.6rem 0.45rem 0.9rem;
    border-radius: 999px;

    background: #111316;
    color: #f5f4f0;
    box-shadow: 0 10px 30px -10px rgb(0 0 0 / 0.6);

    font-size: 0.6875rem;
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .palette-switcher button {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 50%;

    background: none;
    cursor: pointer;
  }

  .palette-switcher button[data-active] {
    border-color: #f5f4f0;
  }

  .palette-switcher i {
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
  }

  @media print {
    .palette-switcher {
      display: none;
    }
  }
</style>
