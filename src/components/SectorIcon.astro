---
/** A miniature elevation drawing for a sector (see src/data/sectors.ts). */
interface Props {
  icon: string;
  class?: string;
}

const { icon, class: className } = Astro.props;
---

<svg
  class:list={['sector-icon', className]}
  viewBox="0 0 64 64"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <Fragment set:html={icon} />
</svg>

<style>
  .sector-icon {
    width: 3.5rem;
    height: 3.5rem;
    overflow: visible;
  }
</style>
