---
import Arrow from './arrow.astro';
import Icon from './icon.astro';
import Media from './media.astro';
import { image } from '../data/images';

interface Props {
  title?: string;
  text?: string;
}

const { title = 'Have a project in mind?', text = 'Tell us what you are planning. We will put the right people on it.' } = Astro.props;

const actions = [
  { href: '/contact/', icon: 'buildings', title: 'Discuss a project', note: 'Clients and consultants' },
  { href: '/contact/#register', icon: 'handshake', title: 'Register with us', note: 'Subcontractors and suppliers' },
  { href: '/contact/#careers', icon: 'hard-hat', title: 'Join the team', note: 'Careers at Al Madar' },
];
---

<section class="cta-band theme-dark">
  <div class="cta-band__backdrop" aria-hidden="true">
    <Media src={image('cta-structure')} alt="" ratio="fill" sizes="100vw" />
  </div>

  <div class="container cta-band__inner">
    <div class="cta-band__copy" data-reveal>
      <p class="label">Work with us</p>
      <h2 class="h1">{title}</h2>
      <p class="lede">{text}</p>
    </div>

    <ul class="cta-band__actions" role="list">
      {
        actions.map((action, index) => (
          <li data-reveal style={`--i:${index + 1}`}>
            <a class="cta-band__action" href={action.href}>
              <Icon name={action.icon} />

              <span>
                <strong class="h3">{action.title}</strong>
                <small>{action.note}</small>
              </span>

              <Arrow />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4.5rem, 2.5rem + 8vw, 9rem);
    background: var(--ink-950);
  }

  .cta-band__backdrop {
    position: absolute;
    inset: 0;
  }

  .cta-band__backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, var(--ink-950) 12%, color-mix(in srgb, var(--ink-950) 70%, transparent) 100%);
  }

  .cta-band__inner {
    position: relative;
    display: grid;
    gap: 3rem;
  }

  .cta-band__copy {
    display: grid;
    justify-items: start;
    gap: 1.4rem;
  }

  .cta-band__actions {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }

  .cta-band__action {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.25rem;
    padding: 1.35rem 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);

    background: color-mix(in srgb, var(--ink-900) 72%, transparent);
    backdrop-filter: blur(10px);
    text-decoration: none;

    transition:
      background-color 0.4s var(--ease-out),
      border-color 0.4s var(--ease-out),
      color 0.4s var(--ease-out),
      transform 0.4s var(--ease-out);
  }

  .cta-band__action span {
    display: grid;
    gap: 0.15rem;
  }

  .cta-band__action small {
    font-size: 0.875rem;
    color: var(--fg-muted);
    transition: color 0.4s var(--ease-out);
  }

  .cta-band__action :global(.icon) {
    width: 2rem;
    height: 2rem;
    color: var(--accent);
    transition: color 0.4s var(--ease-out);
  }

  .cta-band__action > :global(svg:last-child) {
    width: 1.4rem;
    height: 1.4rem;
    transition: transform 0.45s var(--ease-out);
  }

  .cta-band__action:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
    transform: translateX(0.4rem);
  }

  .cta-band__action:hover small,
  .cta-band__action:hover :global(.icon) {
    color: var(--on-accent);
  }

  .cta-band__action:hover > :global(svg:last-child) {
    transform: translateX(0.35rem);
  }

  @media (min-width: 60rem) {
    .cta-band__inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: clamp(3rem, 7vw, 7rem);
      align-items: center;
    }
  }
</style>
