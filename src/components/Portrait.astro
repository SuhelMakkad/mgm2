---
/**
 * Team portrait. Shows the photograph when one is set in the member's frontmatter,
 * otherwise a monogram on the same framed plate.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  name: string;
  photo?: ImageMetadata;
  ratio?: string;
  sizes?: string;
  eager?: boolean;
}

const { name, photo, ratio = '4 / 5', sizes = '(min-width: 64rem) 30vw, (min-width: 40rem) 45vw, 100vw', eager = false } = Astro.props;

const words = name.split(/\s+/).filter(Boolean);
const initials = `${words[0][0]}${words[words.length - 1][0]}`.toUpperCase();
---

<div class="portrait" style={`--ratio:${ratio}`}>
  {
    photo ? (
      <Image class="portrait__image" src={photo} alt={`Portrait of ${name}`} widths={[400, 640, 960]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} />
    ) : (
      <span class="portrait__initials" aria-hidden="true">
        {initials}
      </span>
    )
  }

  <span class="portrait__ring" aria-hidden="true"></span>
</div>

<style>
  .portrait {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    border-radius: var(--radius);
    container-type: inline-size;

    background:
      radial-gradient(120% 80% at 50% 110%, rgb(200 163 95 / 0.16), transparent 60%),
      var(--ink-800);
  }

  .portrait__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease-out);
  }

  .portrait__initials {
    position: relative;
    z-index: 1;
    display: inline-block;

    font-family: var(--font-display);
    font-size: clamp(2.75rem, 22cqi, 5.5rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--brass-300);
  }

  .portrait__ring {
    position: absolute;
    width: 62%;
    aspect-ratio: 1;
    border: 1px solid rgb(200 163 95 / 0.32);
    border-radius: 50%;
    transition: transform 1.1s var(--ease-out);
  }

  .portrait:has(.portrait__image) .portrait__ring {
    display: none;
  }

  :global(a:hover) .portrait__image {
    transform: scale(1.04);
  }

  :global(a:hover) .portrait__ring {
    transform: scale(1.08);
  }
</style>
