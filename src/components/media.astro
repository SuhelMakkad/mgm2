---
/**
 * A responsive photograph in a fixed-ratio frame.
 * Astro resizes it and serves AVIF with a WebP fallback at build time.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;

  /** CSS aspect-ratio of the frame, or "fill" to cover a positioned parent. */
  ratio?: string;

  /** The sizes attribute: how wide the image is shown at each breakpoint. */
  sizes?: string;

  /** CSS object-position, for steering the crop. */
  position?: string;

  /** Load immediately and at high priority. Use for the first image on a page only. */
  eager?: boolean;

  class?: string;
}

const { src, alt, ratio = '3 / 2', sizes = '(min-width: 64rem) 50vw, 100vw', position = 'center', eager = false, class: className } = Astro.props;

const widths = [400, 640, 828, 1100, src.width].filter((width, index, all) => width <= src.width && all.indexOf(width) === index);
---

<div class:list={['media', className]} data-fill={ratio === 'fill' ? '' : undefined} style={`--ratio:${ratio};--position:${position}`}>
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    widths={widths}
    sizes={sizes}
    quality={50}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding={eager ? undefined : 'async'}
  />
</div>

<style>
  .media {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: var(--ink-800);
  }

  .media[data-fill] {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
  }

  .media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--position);
    transition: transform 1.4s var(--ease-out);
  }

  /* Any link that wraps a picture gets a slow push-in on hover. */

  :global(a:hover) .media :global(img) {
    transform: scale(1.06);
  }
</style>
