---
import { withBase } from '../lib/paths';

import Media from './media.astro';
import { image } from '../data/images';
import type { Crumb } from '../layouts/base.astro';

interface Props {
  label: string;
  title: string;
  lede?: string;
  crumbs?: Crumb[];

  /** File name in src/assets/images used as the backdrop. */
  backdrop?: string;

  /** CSS object-position for the backdrop crop. */
  position?: string;
}

const { label, title, lede, crumbs = [], backdrop = 'cta-structure', position = 'center' } = Astro.props;
---

<section class="page-hero theme-dark">
  <div class="page-hero__backdrop" aria-hidden="true">
    <Media src={image(backdrop)} alt="" ratio="fill" sizes="100vw" position={position} eager />
  </div>

  <div class="container page-hero__inner">
    {
      crumbs.length > 0 && (
        <nav class="crumbs rise" aria-label="Breadcrumb">
          <ol role="list">
            <li>
              <a href={withBase('/')}>Home</a>
            </li>

            {crumbs.map((crumb, index) => (
              <li>{index === crumbs.length - 1 ? <span aria-current="page">{crumb.label}</span> : <a href={withBase(crumb.href)}>{crumb.label}</a>}</li>
            ))}
          </ol>
        </nav>
      )
    }

    <p class="label rise" style="--d:1">{label}</p>

    <h1 class="h1">
      <span class="line-mask" style="--d:1"><span>{title}</span></span>
    </h1>

    {lede && <p class="lede rise" style="--d:4">{lede}</p>}

    <div class="page-hero__extra rise" style="--d:5">
      <slot />
    </div>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(46rem, 74svh);
    overflow: hidden;
    padding-block: calc(var(--header-h) + 4rem) clamp(3rem, 2rem + 4vw, 5.5rem);
    background: var(--ink-950);
  }

  .page-hero__backdrop {
    position: absolute;
    inset: 0;
    animation: backdrop-settle 2.4s var(--ease-out) both;
  }

  /* Scrim: dark at the foot for the copy, lighter at the top so the picture reads. */

  .page-hero__backdrop::after {
    content: '';
    position: absolute;
    inset: 0;

    background:
      linear-gradient(to top, var(--ink-950) 2%, color-mix(in srgb, var(--ink-950) 72%, transparent) 42%, color-mix(in srgb, var(--ink-950) 30%, transparent) 100%),
      linear-gradient(to right, color-mix(in srgb, var(--ink-950) 55%, transparent), transparent 70%);
  }

  @keyframes backdrop-settle {
    from {
      transform: scale(1.08);
    }
  }

  .page-hero__inner {
    position: relative;
    display: grid;
    justify-items: start;
    gap: 1.4rem;
  }

  .page-hero .h1 {
    max-width: 14em;
  }

  .page-hero .lede {
    max-width: 34em;
    color: color-mix(in srgb, var(--on-dark) 82%, transparent);
  }

  .page-hero__extra:empty {
    display: none;
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;

    font-size: 0.8125rem;
    color: color-mix(in srgb, var(--on-dark) 70%, transparent);
  }

  .crumbs li + li::before {
    content: '/';
    margin-right: 0.5rem;
    opacity: 0.5;
  }

  .crumbs a {
    text-decoration: none;
    transition: color 0.2s;
  }

  .crumbs a:hover {
    color: var(--fg);
  }
</style>
