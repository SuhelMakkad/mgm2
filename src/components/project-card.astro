---
import { withBase } from '../lib/paths';

import type { CollectionEntry } from 'astro:content';

import Icon from './icon.astro';
import Media from './media.astro';
import { image as findImage } from '../data/images';
import { sectorById } from '../data/sectors';
import { statusLabels } from '../data/projects';

interface Props {
  project: CollectionEntry<'projects'>;
  eager?: boolean;

  /** Heading element for the title, so the card fits the outline of the page it is on. */
  heading?: 'h2' | 'h3';

  /** Frame ratio and sizes attribute, for cards shown larger than the default grid. */
  ratio?: string;
  sizes?: string;
}

const { project, eager = false, heading: Heading = 'h3', ratio = '4 / 3', sizes = '(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw' } = Astro.props;
const { title, summary, status, location, image, imageAlt, sample } = project.data;

const sector = sectorById.get(project.data.sector);
const picture = image ?? findImage(sector?.image ?? 'hero-home');
---

<article class="project-card" data-status={status} data-sector={project.data.sector}>
  <a class="project-card__link" href={withBase(`/projects/${project.id}/`)}>
    <div class="project-card__media">
      <Media src={picture} alt={imageAlt ?? title} ratio={ratio} sizes={sizes} eager={eager} />

      <p class="project-card__tags">
        <span class="tag" data-status={status}>{statusLabels[status]}</span>
        {sample && <span class="tag tag--sample">Sample</span>}
      </p>

      <span class="project-card__go" aria-hidden="true">
        <Icon name="arrow-up-right-bold" />
      </span>
    </div>

    <div class="project-card__body">
      <Heading class="h3">{title}</Heading>
      <p class="muted">{summary}</p>

      <p class="project-card__foot">
        {
          sector && (
            <span>
              <Icon name={sector.icon} />
              {sector.name}
            </span>
          )
        }

        <span>
          <Icon name="map-pin" />
          {location}
        </span>
      </p>
    </div>
  </a>
</article>

<style>
  .project-card,
  .project-card__link {
    height: 100%;
  }

  .project-card__link {
    display: grid;
    gap: 1.25rem;
    align-content: start;

    text-decoration: none;
    color: inherit;
  }

  .project-card__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
  }

  .project-card__tags {
    position: absolute;
    top: 0.9rem;
    left: 0.9rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  /* Tags sit on the photograph, so they always use the light chip. */

  .project-card__tags .tag {
    background: var(--surface);
    color: var(--text);
  }

  .project-card__tags .tag--sample {
    background: color-mix(in srgb, var(--ink-950) 62%, transparent);
    border-color: color-mix(in srgb, var(--on-dark) 55%, transparent);
    color: var(--on-dark);
    backdrop-filter: blur(6px);
  }

  .project-card__go {
    position: absolute;
    right: 0.9rem;
    bottom: 0.9rem;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;

    background: var(--accent);
    color: var(--on-accent);

    opacity: 0;
    transform: translate(-0.6rem, 0.6rem) scale(0.8);
    transition:
      opacity 0.4s var(--ease-out),
      transform 0.5s var(--ease-out);
  }

  .project-card__go :global(.icon) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .project-card__link:hover .project-card__go,
  .project-card__link:focus-visible .project-card__go {
    opacity: 1;
    transform: none;
  }

  .project-card__body {
    display: grid;
    gap: 0.6rem;
    justify-items: start;
  }

  .project-card .muted {
    font-size: 0.9688rem;
  }

  .project-card__foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin-top: 0.3rem;

    font-size: 0.8438rem;
    font-weight: 560;
  }

  .project-card__foot span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .project-card__foot :global(.icon) {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--accent-text);
  }
</style>
