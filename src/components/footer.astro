---
import Brand from './brand.astro';
import Arrow from './arrow.astro';
import Icon from './icon.astro';
import { site, contact, footerNav, groupCompanies } from '../data/site';

const year = new Date().getFullYear();
const mottoLines = site.motto.split('. ').map((line) => (line.endsWith('.') ? line : `${line}.`));
---

<footer class="site-footer theme-dark">
  <div class="container">
    <div class="site-footer__top">
      <p class="site-footer__motto h2">
        {mottoLines.map((line) => <span>{line}</span>)}
      </p>

      <a class="btn" href="/contact/">
        Start a conversation
        <Arrow />
      </a>
    </div>

    <div class="site-footer__grid">
      <div class="site-footer__about">
        <Brand />

        <address>
          <span>
            <Icon name="map-pin" />
            {site.locality}, {site.country}
          </span>

          <a href={`mailto:${contact.email}`}>
            <Icon name="envelope-simple" />
            {contact.email}
          </a>

          {
            contact.phone && (
              <a href={`tel:${contact.phone.replace(/[^\d+]/g, '')}`}>
                <Icon name="phone" />
                {contact.phone}
              </a>
            )
          }
        </address>
      </div>

      {
        footerNav.map((column) => (
          <nav aria-label={column.title}>
            <h2 class="site-footer__title">{column.title}</h2>

            <ul role="list">
              {column.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <div>
        <h2 class="site-footer__title">Group companies</h2>

        <ul role="list">
          {groupCompanies.map((company) => <li>{company.url ? <a href={company.url}>{company.name}</a> : company.name}</li>)}
        </ul>
      </div>
    </div>

    <div class="site-footer__base">
      <p>© {year} {site.name}. All rights reserved.</p>
      <p>Established {site.founded} · {site.locality}, UAE</p>
    </div>
  </div>

  <div class="site-footer__wordmark" data-text={site.shortName} aria-hidden="true"></div>
</footer>

<style>
  .site-footer {
    --bg: var(--ink-950);

    position: relative;
    overflow: hidden;
    background: var(--bg);
    padding-top: clamp(3.5rem, 2rem + 6vw, 6.5rem);
  }

  .site-footer__top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;

    padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
    border-bottom: 1px solid var(--line);
  }

  .site-footer__motto {
    display: grid;
  }

  .site-footer__motto span:last-child {
    color: var(--accent);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 2rem;
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .site-footer__about {
    grid-column: 1 / -1;
    display: grid;
    gap: 1.5rem;
    align-content: start;
    justify-items: start;
    font-size: 0.9375rem;
  }

  .site-footer address {
    display: grid;
    gap: 0.6rem;
    color: var(--fg-muted);
  }

  .site-footer address > * {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .site-footer address :global(.icon) {
    width: 1.15rem;
    height: 1.15rem;
    color: var(--accent);
  }

  .site-footer__title {
    margin-bottom: 1rem;

    font-size: 0.75rem;
    font-weight: 650;
    font-stretch: 112%;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg);
  }

  .site-footer ul {
    display: grid;
    gap: 0.6rem;
    margin: 0;

    font-size: 0.9375rem;
    color: var(--fg-muted);
  }

  .site-footer a {
    text-decoration: none;
    color: var(--fg-muted);
    transition: color 0.2s;
  }

  .site-footer a:hover {
    color: var(--fg);
  }

  .site-footer .btn {
    color: var(--on-accent);
  }

  .site-footer .btn:hover {
    color: var(--bg);
  }

  .site-footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;

    padding-block: 1.5rem;
    border-top: 1px solid var(--line);

    font-size: 0.8125rem;
    color: var(--fg-muted);
  }

  /* Oversized wordmark, cropped by the foot of the page. */

  .site-footer__wordmark::before {
    content: attr(data-text);
  }

  .site-footer__wordmark {
    margin-bottom: -0.2em;

    font-size: 10vw;
    font-weight: 800;
    font-stretch: 125%;
    line-height: 0.8;
    letter-spacing: -0.045em;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--ink-800);

    user-select: none;
  }

  @media (min-width: 48rem) {
    .site-footer__grid {
      grid-template-columns: 1.6fr repeat(4, minmax(0, 1fr));
    }

    .site-footer__about {
      grid-column: auto;
    }
  }
</style>
