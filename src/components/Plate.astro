---
/**
 * A framed picture slot with drawing-sheet corner marks.
 * Shows `image` when one is supplied, otherwise a line drawing stands in for it.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  /** Inner SVG markup of a 64×64 line drawing (see src/data/sectors.ts). */
  drawing: string;

  image?: ImageMetadata;
  alt?: string;

  /** CSS aspect-ratio value. */
  ratio?: string;

  tone?: 'dark' | 'light';
  sizes?: string;
  eager?: boolean;
  class?: string;
}

const { drawing, image, alt = '', ratio = '4 / 3', tone = 'dark', sizes = '(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw', eager = false, class: className } = Astro.props;
---

<div class:list={['plate', className]} data-tone={tone} style={`--ratio:${ratio}`}>
  {
    image ? (
      <Image class="plate__image" src={image} alt={alt} widths={[480, 800, 1200, 1600]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} />
    ) : (
      <svg
        class="plate__drawing"
        viewBox="0 0 64 64"
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <Fragment set:html={drawing} />
      </svg>
    )
  }

  <span class="plate__marks" aria-hidden="true"></span>
</div>

<style>
  .plate {
    --mark: rgb(233 236 232 / 0.5);
    --grid: rgb(233 236 232 / 0.045);

    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    border-radius: var(--radius);

    background-color: var(--ink-800);
    background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 1.75rem 1.75rem;
    background-position: center;

    color: var(--brass-300);
  }

  .plate[data-tone='light'] {
    --mark: rgb(19 33 39 / 0.4);
    --grid: rgb(19 33 39 / 0.05);

    background-color: var(--paper-3);
    color: var(--ink-700);
  }

  .plate__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease-out);
  }

  .plate__drawing {
    position: absolute;
    inset: 0;
    width: 46%;
    height: auto;
    margin: auto;
    overflow: visible;
    transition: transform 1.1s var(--ease-out);
  }

  .plate__drawing :global(*) {
    stroke-width: 1.2px;
    vector-effect: non-scaling-stroke;
  }

  .plate__marks {
    --m: 0.75rem;

    position: absolute;
    inset: 0.8rem;
    pointer-events: none;

    background:
      linear-gradient(var(--mark), var(--mark)) top left / var(--m) 1px,
      linear-gradient(var(--mark), var(--mark)) top left / 1px var(--m),
      linear-gradient(var(--mark), var(--mark)) top right / var(--m) 1px,
      linear-gradient(var(--mark), var(--mark)) top right / 1px var(--m),
      linear-gradient(var(--mark), var(--mark)) bottom left / var(--m) 1px,
      linear-gradient(var(--mark), var(--mark)) bottom left / 1px var(--m),
      linear-gradient(var(--mark), var(--mark)) bottom right / var(--m) 1px,
      linear-gradient(var(--mark), var(--mark)) bottom right / 1px var(--m);
    background-repeat: no-repeat;

    transition: inset 0.6s var(--ease-out);
  }

  /* Any link that wraps a plate gets the same quiet hover. */

  :global(a:hover) .plate__image,
  :global(a:hover) .plate__drawing {
    transform: scale(1.045);
  }

  :global(a:hover) .plate__marks {
    inset: 0.55rem;
  }
</style>
